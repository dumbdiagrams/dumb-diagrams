{
  "name": "dumb-diagrams",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.23.0 <12"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-registry.mjs",
    "icons:check": "node scripts/icon-workflow.mjs check",
    "icons:update": "node scripts/icon-workflow.mjs update",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:stage": "node scripts/stage-catalog-assets.mjs",
    "icons:build": "pnpm catalog:generate && pnpm catalog:stage",
    "build": "pnpm catalog:generate && pnpm --filter @dumb-diagrams/runtime build && pnpm --filter @dumb-diagrams/editor build && pnpm --filter create-dumb-diagrams exec tsc -p tsconfig.json",
    "pretest": "pnpm catalog:stage",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:integration": "vitest run tests/integration",
    "pretest:coverage": "pnpm catalog:stage",
    "test:coverage": "vitest run --coverage && pnpm check:coverage",
    "check:coverage": "node scripts/warn-coverage.mjs",
    "typecheck": "pnpm --filter @dumb-diagrams/editor typecheck",
    "check:versions": "node scripts/check-versions.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:advisories": "pnpm audit --prod --audit-level high",
    "check:style": "biome ci",
    "check:release": "pnpm check:style && pnpm icons:check && pnpm check:versions && pnpm check:dependencies && pnpm check:advisories && pnpm build && pnpm check:results && pnpm test:coverage && pnpm typecheck && pnpm check && pnpm check:routing && pnpm check:performance && pnpm check:assets && pnpm exec playwright install chromium --with-deps && pnpm test:e2e && pnpm test:e2e:packed && pnpm smoke:package && pnpm check:website",
    "smoke:package": "node scripts/smoke-cli-package.mjs && node scripts/check-asset-budget.mjs",
    "publish:metadata": "node scripts/set-cli-publish-metadata.mjs",
    "preflight:publish": "node scripts/preflight-npm.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:stress": "playwright test --project=chromium --repeat-each=3",
    "test:e2e:packed": "playwright test --config playwright.packed.config.ts",
    "precheck:routing": "pnpm --filter @dumb-diagrams/runtime build",
    "check:routing": "node scripts/check-routing-baseline.mjs",
    "preupdate:layout-contracts": "pnpm --filter @dumb-diagrams/runtime build",
    "update:layout-contracts": "node scripts/update-layout-contracts.mjs",
    "check:curated": "node scripts/check-curated-baseline.mjs",
    "check:agent-init-evaluation": "node scripts/check-agent-init-evaluation.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:assets": "node scripts/check-asset-budget.mjs",
    "check": "pnpm check:curated && pnpm check:agent-init-evaluation",
    "dev": "pnpm --filter @dumb-diagrams/editor dev",
    "dev:cli": "node packages/cli/dist/index.js studio",
    "dev:website": "pnpm --filter @dumb-diagrams/website dev",
    "build:website": "pnpm --filter @dumb-diagrams/website build",
    "preview:website": "pnpm --filter @dumb-diagrams/website preview",
    "check:website": "pnpm --filter @dumb-diagrams/website check && pnpm build:website && pnpm --filter @dumb-diagrams/website test",
    "test:e2e:compat": "playwright test --project=webkit",
    "check:results": "eslint --config eslint.results.config.mjs packages/runtime/src packages/editor/src packages/cli/src"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.12",
    "eslint": "10.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.23.0",
  "description": "LLM-first architecture diagrams that are hard to get wrong: deterministic layout, validated source, local Studio.",
  "license": "AGPL-3.0-only"
}
