{
  "name": "dumb-diagrams",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.23.0 <12"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-registry.mjs",
    "icons:check": "node scripts/icon-workflow.mjs check",
    "icons:update": "node scripts/icon-workflow.mjs update",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:stage": "node scripts/stage-catalog-assets.mjs",
    "icons:build": "pnpm catalog:generate && pnpm catalog:stage",
    "build": "pnpm catalog:generate && pnpm --filter @dumb-diagrams/runtime build && pnpm --filter @dumb-diagrams/editor build && pnpm --filter create-dumb-diagrams build",
    "pretest": "pnpm catalog:stage",
    "test": "vitest run",
    "pretest:coverage": "pnpm catalog:stage",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --filter @dumb-diagrams/editor typecheck",
    "check:versions": "node scripts/check-versions.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:release": "pnpm check:versions && pnpm check:dependencies && pnpm build && pnpm test:coverage && pnpm typecheck && pnpm check && pnpm check:routing && pnpm check:performance && pnpm check:assets && pnpm exec playwright install chromium webkit && pnpm test:e2e && pnpm test:e2e:packed && pnpm smoke:package",
    "smoke:package": "node scripts/smoke-cli-package.mjs",
    "preflight:publish": "node scripts/preflight-npm.mjs",
    "test:e2e": "playwright test",
    "test:e2e:packed": "playwright test --config playwright.packed.config.ts",
    "precheck:routing": "pnpm --filter @dumb-diagrams/runtime build",
    "check:routing": "node scripts/check-routing-baseline.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:assets": "node scripts/check-asset-budget.mjs",
    "check": "node packages/cli/dist/index.js check examples/diagrams",
    "render": "node packages/cli/dist/index.js render",
    "dev": "pnpm --filter @dumb-diagrams/editor dev",
    "dev:cli": "node packages/cli/dist/index.js studio",
    "dev:website": "pnpm --filter @dumb-diagrams/website dev",
    "build:website": "pnpm --filter @dumb-diagrams/website build",
    "preview:website": "pnpm --filter @dumb-diagrams/website preview",
    "check:website": "pnpm --filter @dumb-diagrams/website check && pnpm build:website && pnpm --filter @dumb-diagrams/website test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.23.0",
  "description": "LLM-first architecture diagrams that are hard to get wrong: deterministic layout, validated source, local Studio.",
  "license": "AGPL-3.0-only"
}
