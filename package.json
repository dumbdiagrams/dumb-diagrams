{
  "name": "dumb-diagrams",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "icons:check": "node scripts/icon-workflow.mjs check",
    "icons:update": "node scripts/icon-workflow.mjs update",
    "icons:build": "node scripts/icon-workflow.mjs build",
    "sync:icons": "node scripts/sync-icon-packs.mjs",
    "build": "pnpm icons:build && pnpm -r run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --filter @dumb-diagrams/editor typecheck",
    "check:versions": "node scripts/check-versions.mjs",
    "check:release": "pnpm check:versions && pnpm build && pnpm test:coverage && pnpm typecheck && pnpm check && pnpm exec playwright install chromium && pnpm test:e2e && pnpm smoke:package",
    "smoke:package": "node scripts/smoke-cli-package.mjs",
    "preflight:publish": "node scripts/preflight-npm.mjs",
    "test:e2e": "playwright test",
    "check": "node packages/cli/dist/index.js check examples/src",
    "render": "node packages/cli/dist/index.js render",
    "dev": "pnpm --filter @dumb-diagrams/editor dev",
    "dev:cli": "node packages/cli/dist/index.js studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^3.0.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@9.15.4",
  "description": "LLM-first diagrams with deterministic layout and practical manual controls.",
  "license": "MIT"
}
