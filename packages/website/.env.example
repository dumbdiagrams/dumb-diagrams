# Public origin for canonical URLs and the sitemap (no path here).
SITE_URL=https://dumbdiagrams.com
# Optional subdirectory, including the trailing slash.
BASE_PATH=/
# Required before the privacy notice can be published as indexable or analytics enabled.
# Match the retention value to the GA4 property if analytics will be used.
# PUBLIC_SITE_OPERATOR=Your name or organization
# PUBLIC_PRIVACY_EMAIL=privacy@example.com
# PUBLIC_ANALYTICS_RETENTION_MONTHS=2
# Optional repository URL override. Defaults to this project's GitHub repo.
# PUBLIC_REPOSITORY_URL=https://github.com/your-org/your-repo
# Enable only when adding consent-aware third-party scripts. Off by default.
ENABLE_PARTYTOWN=false
