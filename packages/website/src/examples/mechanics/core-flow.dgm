diagram core_flow {
  grammar aws
  flow lr
  title "Request to durable storage"

  cloud-agnostic.actor client "Client"
  cloud-agnostic.server api "API"
  cloud-agnostic.server worker "Worker"
  cloud-agnostic.server storage "Storage"

  client -> api { id request label "request" }
  api -> worker { id dispatch label "dispatch" }
  worker -> storage { id persist label "persist" }
}
