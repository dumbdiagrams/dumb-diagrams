diagram events {
  grammar aws
  flow lr
  title "Event-driven orders"

  generic.user customer "Customer"
  aws.region region "AWS Region" {
    aws.api-gateway api "Orders API"
    aws.simple-queue-service queue "Order queue"
    aws.aws-lambda worker "Order worker"
  }

  customer -> api { id order step 1 }
  api -> queue { id enqueue step 2 }
  queue -> worker { id process step 3 }
}
