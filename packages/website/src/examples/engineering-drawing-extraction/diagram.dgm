  route write-result { point 1262 404 point 968 404 point 968 372 point 908 372 mode manual pin badge 0.8238341968911918 top label 0.844559585492228 bottom }
  route publish-result { point 1262 416 point 976 416 point 976 492 point 910 492 mode manual pin badge 0.3341121495327103 bottom label 0.8162383177570094 bottom }
  route consume-result { point 862 492 point 664 492 point 664 452 point 627 452 mode manual pin badge 0.36 top label 0.41818181818181815 bottom }
  route validate-result { point 627 440 point 664 440 point 664 372 point 860 372 mode manual pin badge 0.6744186046511628 top label 0.6744186046511628 bottom }
  route update-job-db { point 579 452 point 544 452 point 544 544 point 376 544 point 376 452 point 339 452 mode manual pin badge 0.5776415094339622 top label 0.5776415094339622 bottom }
  route read-status { point 464 440 point 339 440 mode manual pin label 0.5 top }
  route request-dlq { point 886 268 point 886 336 point 800 336 point 800 620 point 862 620 mode manual pin label 0.7868283567245434 bottom }
  route result-dlq { point 910 504 point 976 504 point 976 712 point 886 712 point 886 724 mode manual pin label 0.9293587858040014 top }
  route monitor-extraction { point 1310 416 point 1429 416 point 1429 508 mode manual pin label 0.8104265402843602 bottom }
  annotation note-ownership { x 752 y -96 w 280 pin manual }
  annotation note-transport { x 1153 y 168 pin manual }
  annotation note-ordering { x 144 y 168 w 285 pin manual }
  annotation note-idempotency { x 48 y 576 pin manual }
  annotation note-reliability { x 738 y 888 pin manual }
  annotation note-status { x 363 y 584 pin manual }
}
