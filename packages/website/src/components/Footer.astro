---
import { url, npmUrl } from '../lib/site';
---
<footer class="site-footer">
  <div class="footer-top">
    <a class="brand" href={url()} aria-label="Dumb Diagrams home"><span class="dd-wordmark">dumb<span class="dd-wordmark__light">diagrams</span><span class="dd-wordmark__dot">.</span></span></a>
    <p class="footer-motto"><strong>A little opinionated.</strong><br /><strong>A lot clearer.</strong></p>
    <div class="footer-links"><a href={url('docs/')}>Read the docs <span aria-hidden="true">↗</span></a><a href="https://studio.dumbdiagrams.com" data-studio-link target="_blank" rel="noopener noreferrer">Open Studio <span aria-hidden="true">↗</span></a></div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Dumb Diagrams contributors</span>
    <div><a href={url('LICENSE.txt')}>AGPL-3.0</a><a href={url('ICON-NOTICES.txt')}>Icon credits</a><a href={url('FONT-LICENSES.txt')}>Font credits</a><a href={npmUrl} target="_blank" rel="noopener noreferrer">npm ↗</a></div>
    <span class="local-note"><span></span> Local files. Yours to keep.</span>
  </div>
  <p class="footer-license-note">Dumb Diagrams source code is licensed under AGPL-3.0-only, except where otherwise indicated. AWS, Microsoft Azure, and Google Cloud architecture artwork remains subject to the respective providers’ terms and trademark rights. Inclusion in this repository does not grant additional rights to those assets.</p>
  <div class="footer-privacy">
    <nav aria-label="Privacy controls"><a href={url('privacy/')}>Privacy &amp; cookies</a><a class="footer-cookie-settings" href={url('privacy/#cookie-settings')} data-analytics-settings>Cookie preferences</a><button class="footer-cookie-revoke" type="button" data-analytics-revoke hidden>Revoke analytics consent</button></nav>
  </div>
</footer>
