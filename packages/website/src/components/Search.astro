---
import { url } from '../lib/site';
---
<button type="button" class="search-trigger" data-search-open><span>Search the docs</span><kbd>⌘ K</kbd></button>
<dialog class="search-dialog" data-search-dialog data-base={url()} aria-labelledby="search-title">
  <div class="search-dialog-head"><label id="search-title" class="sr-only" for="docs-search">Search documentation</label><input id="docs-search" type="search" placeholder="What would you like to know?" autocomplete="off" /><button type="button" data-search-close aria-label="Close search">Esc</button></div>
  <div class="search-results" data-search-results aria-live="polite"><p>Find a command, a workflow, or a little more context.</p></div>
  <div class="search-dialog-foot mono">LOCAL SEARCH · NO DATA LEAVES YOUR BROWSER</div>
</dialog>
<!-- Pagefind is generated after Astro. Leave this small module native so Vite
     does not rewrite its dynamic import into a build-time dependency. -->
<script is:inline type="module">
  const dialog = document.querySelector('[data-search-dialog]');
  const input = dialog?.querySelector('input');
  const results = dialog?.querySelector('[data-search-results]');
  let searchModule;
  let revision = 0;
  let timer;
  let lastFocus = null;
  function openSearch() {
    if (!dialog || dialog.open) return;
    lastFocus = document.activeElement;
    dialog.showModal();
    input?.focus();
  }
  document.querySelector('[data-search-open]')?.addEventListener('click', openSearch);
  dialog?.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('close', () => lastFocus?.focus());
  dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && dialog?.open) { dialog.close(); return; }
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog?.open) dialog.close(); else openSearch();
    }
  });
  input?.addEventListener('input', () => {
    clearTimeout(timer);
    const current = ++revision;
    const query = input.value.trim();
    if (!results) return;
    if (!query) { results.innerHTML = '<p>Find a command, a workflow, or a little more context.</p>'; return; }
    timer = setTimeout(async () => {
      try {
        const base = dialog?.dataset.base || '/';
        searchModule ||= import(`${base}pagefind/pagefind.js`);
        const pagefind = await searchModule;
        const found = await pagefind.search(query);
        const entries = await Promise.all(found.results.slice(0, 8).map(result => result.data()));
        if (current !== revision) return;
        results.replaceChildren();
        if (!entries.length) { results.innerHTML = '<p>No matches. Try “Studio”, “export”, or “validate”.</p>'; return; }
        for (const result of entries) {
          const link = document.createElement('a');
          link.href = result.url;
          const heading = document.createElement('strong');
          heading.textContent = result.meta.title || 'Documentation';
          const excerpt = document.createElement('span');
          // Pagefind excerpts are escaped HTML with <mark> around matching terms.
          const parsed = new DOMParser().parseFromString(result.excerpt, 'text/html');
          excerpt.textContent = parsed.body.textContent;
          link.append(heading, excerpt);
          results.append(link);
        }
      } catch (error) {
        console.error('Documentation search could not load:', error);
        searchModule = undefined;
        if (current === revision) results.innerHTML = '<p>Search could not load. Please try again, or use the documentation navigation. If you are developing locally, build and preview the site to generate its search index.</p>';
      }
    }, 120);
  });
</script>
