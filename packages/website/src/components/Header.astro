---
import { url, npmUrl, repository } from '../lib/site';
import { Image } from 'astro:assets';
import logo from '../../../editor/public/logo_dumbdiagrams.png';
const { docs = false } = Astro.props;
---
<header class="site-header">
  <a class="brand" href={url()} aria-label="Dumb Diagrams home">
    <Image src={logo} width={52} height={31} widths={[52, 104]} sizes="52px" format="webp" alt="" loading="eager" />
    <span class="dd-wordmark">dumb<span class="dd-wordmark__light">diagrams</span><span class="dd-wordmark__dot">.</span></span>
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    <a href={url('#how-it-works')}>How it works</a>
    <a href={url('docs/')} aria-current={docs ? 'page' : undefined}>Documentation</a>
    <a href={repository || npmUrl}>{repository ? 'Source code' : 'npm'} <span aria-hidden="true">↗</span></a>
  </nav>
  <a
    class="github-link"
    href={repository || undefined}
    target={repository ? '_blank' : undefined}
    rel={repository ? 'noopener noreferrer' : undefined}
    aria-disabled={repository ? undefined : 'true'}
    title={repository ? 'Open the GitHub repository' : 'GitHub repository coming soon'}
  >
    <svg class="github-link__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.5-3.79-1.5-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.71 2.62 1.22 3.26.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.01-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.77 10.77 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.78 1.16 1.78 1.16 3.01 0 4.33-2.64 5.28-5.15 5.56.4.35.76 1.04.76 2.1v3.11c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" />
    </svg>
    <span class="github-link__label">GitHub</span>
  </a>
  <a class="header-cta trace-border" href={url('docs/quick-start/')}>Get started <span aria-hidden="true">↗</span></a>
  <details class="mobile-nav">
    <summary aria-label="Navigation menu"><span aria-hidden="true">☰</span></summary>
    <nav aria-label="Mobile navigation">
      <a href={url('#how-it-works')}>How it works</a>
      <a href={url('docs/')}>Documentation</a>
      <a href={repository || npmUrl}>{repository ? 'Source code' : 'npm package'} ↗</a>
      <a href={url('docs/quick-start/')}>Get started ↗</a>
    </nav>
  </details>
</header>
