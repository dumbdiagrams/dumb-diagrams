---
import awsLogo from '../assets/providers/aws.svg';
import azureLogo from '../assets/providers/azure.svg';
import gcpLogo from '../assets/providers/gcp.svg';
---
<div class="provider-strip">
  <div class="provider-strip-panel" aria-label="Supported cloud providers">
    <p class="provider-strip-heading"><i aria-hidden="true"></i>we support</p>
    <div class="provider-strip-logos">
      <span class="provider-strip-logo provider-strip-logo--aws"><img src={awsLogo.src} alt="Amazon Web Services" width={awsLogo.width} height={awsLogo.height} loading="lazy" decoding="async" /></span>
      <span class="provider-strip-logo provider-strip-logo--azure"><img src={azureLogo.src} alt="Microsoft Azure" width={azureLogo.width} height={azureLogo.height} loading="lazy" decoding="async" /></span>
      <span class="provider-strip-logo provider-strip-logo--gcp"><img src={gcpLogo.src} alt="Google Cloud Platform" width={gcpLogo.width} height={gcpLogo.height} loading="lazy" decoding="async" /></span>
      <span class="provider-strip-logo provider-strip-logo--agnostic">
        <svg class="provider-strip-cloud" viewBox="1 2 22 18" aria-hidden="true"><path d="M7.4 18h9.5a4.1 4.1 0 0 0 .5-8.2A5.6 5.6 0 0 0 6.9 8.4 4.8 4.8 0 0 0 7.4 18Z" /></svg>
        <span class="provider-strip-label">Cloud Agnostic</span>
      </span>
    </div>
  </div>
</div>
