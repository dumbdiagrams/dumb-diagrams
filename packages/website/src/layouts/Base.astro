---
import '@dumb-diagrams/brand/styles.css';
import { brandFont, codeFont } from '@dumb-diagrams/brand/fonts';
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { analyticsConfig } from '../lib/analytics-config.mjs';
import { url } from '../lib/site';
interface Props { title?: string; description?: string; docs?: boolean; noindex?: boolean; structuredData?: Record<string, unknown> }
const { title = 'Architecture diagrams as code for AI coding agents', description = 'Create architecture diagrams as code with your coding agent. Automatic layout, local visual editing, and SVG, PNG or PDF exports. Free and open source.', docs = false, noindex = false, structuredData } = Astro.props;
const { measurementId } = analyticsConfig();
const analyticsEnabled = Boolean(import.meta.env.PROD && measurementId);
const consentPreview = Boolean(import.meta.env.DEV && !analyticsEnabled);
const pageTitle = `${title} | Dumb Diagrams`;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site ? new URL(url('social-card.png'), Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="preload" href={brandFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={codeFont} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dumb Diagrams" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <>
      <meta property="og:image" content={socialImage.href} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="2400" />
      <meta property="og:image:height" content="1260" />
      <meta property="og:image:alt" content="Dumb Diagrams social card: A little opinionated. A lot clearer., alongside a rendered factory IoT telemetry diagram using AWS services." />
    </>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <>
      <meta name="twitter:image" content={socialImage.href} />
      <meta name="twitter:image:alt" content="Dumb Diagrams social card: A little opinionated. A lot clearer., alongside a rendered factory IoT telemetry diagram using AWS services." />
    </>}
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="alternate" type="text/plain" title="Documentation for agents" href={url('llms.txt')} />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />}
  </head>
  <body class:list={[docs && 'docs-page']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell"><Header docs={docs} /><slot /><Footer /></div>
    {(analyticsEnabled || consentPreview) && <Analytics measurementId={measurementId} enabled={analyticsEnabled} preview={consentPreview} />}
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
