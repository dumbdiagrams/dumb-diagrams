---
import '@dumb-diagrams/brand/styles.css';
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/site';
interface Props { title?: string; description?: string; docs?: boolean; noindex?: boolean }
const { title = 'Architecture diagrams from plain text.', description = 'Use a coding agent for the first draft, refine the result in Studio, and keep the source beside your code.', docs = false, noindex = false } = Astro.props;
const pageTitle = `${title} | Dumb Diagrams`;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f2" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dumb Diagrams" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="alternate" type="text/plain" title="Documentation for agents" href={url('llms.txt')} />
  </head>
  <body class:list={[docs && 'docs-page']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell"><Header docs={docs} /><slot /><Footer /></div>
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
