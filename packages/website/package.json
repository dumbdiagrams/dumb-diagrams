{
  "name": "@dumb-diagrams/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "prepare:assets": "pnpm --filter @dumb-diagrams/runtime build && pnpm --filter create-dumb-diagrams build && node scripts/capture-cli.mjs && node scripts/prepare-assets.mjs && node scripts/prepare-docs-explainers.mjs",
    "predev": "pnpm prepare:assets",
    "dev": "astro dev --host 127.0.0.1",
    "prebuild": "pnpm prepare:assets",
    "build": "astro build && pagefind --site dist --glob 'docs/**/*.html'",
    "preview": "astro preview --host 127.0.0.1",
    "precheck": "pnpm --filter @dumb-diagrams/runtime build",
    "check": "astro check",
    "test": "node --test scripts/site.test.mjs scripts/analytics.test.mjs",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@astrojs/partytown": "2.1.9",
    "@astrojs/sitemap": "3.7.4",
    "@dumb-diagrams/brand": "workspace:*",
    "@dumb-diagrams/runtime": "workspace:*",
    "astro": "7.4.5",
    "neverthrow": "8.2.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "pagefind": "1.6.0",
    "typescript": "^5.7.3"
  }
}
