{
  "name": "@dumb-diagrams/website",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "predev": "pnpm prepare:assets && node scripts/generate-social-card.mjs",
    "dev": "node ../../scripts/start-website-dev.mjs",
    "prebuild": "pnpm prepare:assets && node scripts/generate-social-card.mjs",
    "build": "astro build && pagefind --site dist --glob 'docs/**/*.html' && pnpm --dir ../.. build:studio:hosted",
    "preview": "node ../../scripts/start-website-preview.mjs",
    "precheck": "pnpm --filter @dumb-diagrams/runtime build",
    "check": "astro check",
    "test": "node --test scripts/site.test.mjs scripts/analytics.test.mjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "prepare:assets": "pnpm --filter @dumb-diagrams/runtime build && pnpm --filter create-dumb-diagrams build && node scripts/capture-cli.mjs && node scripts/prepare-assets.mjs && node scripts/prepare-docs-explainers.mjs"
  },
  "dependencies": {
    "@astrojs/partytown": "2.1.9",
    "@astrojs/sitemap": "3.7.4",
    "@dumb-diagrams/brand": "workspace:*",
    "@dumb-diagrams/runtime": "workspace:*",
    "astro": "7.4.5",
    "neverthrow": "8.2.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "pagefind": "1.5.2",
    "typescript": "^5.7.3"
  }
}
