{
  "name": "create-dumb-diagrams",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "LLM-first architecture diagrams that are hard to get wrong: local CLI and Studio for .dgm source files",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "diagrams",
    "architecture",
    "aws",
    "cli",
    "dgm",
    "studio"
  ],
  "files": [
    "dist",
    "LICENSE",
    "ICON-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "create-dumb-diagrams": "./dist/create.js",
    "dumbdiagrams": "./dist/index.js",
    "dgm": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare:standalone": "node ../../scripts/prepare-cli-package.mjs",
    "prepack": "node ../../scripts/prepare-cli-package.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@dumb-diagrams/runtime": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
