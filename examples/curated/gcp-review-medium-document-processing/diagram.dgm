dgm 1
diagram gcp-review-medium-document-processing {
  grammar gcp
  flow lr
  title "Google Cloud document processing"

  cloud-agnostic.client partner "Document partner"

  gcp.organization organization "Google Cloud organization" {
    gcp.project project "Document processing project" {
      gcp.region region "Primary region" {
        gcp.cloud-run intake "Document intake (Cloud Run)"
        gcp.cloud-storage source "Original documents bucket"
        gcp.pub-sub events "Document events topic"
        gcp.cloud-run processor "Document processor (Cloud Run)"
        gcp.cloud-storage normalized "Normalized documents bucket"
        gcp.cloud-sql metadata "Processing status and metadata"
      }
    }
  }

  partner -> intake { id upload_documents label "Document uploads" step 1 kind flow }
  intake -> source { id store_original label "Store original" step 2 kind flow }
  source -> events { id publish_object_event label "Object notification" step 3 kind flow }
  events -> processor { id consume_document_event label "Consume event" step 4 kind flow }
  source -> processor { id read_original label "Read original" kind flow }
  processor -> normalized { id write_normalized label "Store normalized" step 5 kind flow }
  processor -> metadata { id write_processing_metadata label "Write status and metadata" step 6 kind flow }
}
