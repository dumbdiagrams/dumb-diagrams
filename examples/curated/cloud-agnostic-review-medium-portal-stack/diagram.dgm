dgm 1
diagram cloud-agnostic-review-medium-portal-stack {
  grammar cloud-agnostic
  flow lr
  title "Provider-neutral project portal"

  cloud-agnostic.client users "Project team"

  cloud-agnostic.cloud cloud "Cloud environment" {
    cloud-agnostic.account account "Production account" {
      cloud-agnostic.region region "Primary region" {
        cloud-agnostic.load-balancer edge "Portal load balancer"
        cloud-agnostic.object-storage attachments "Project attachments"

        cloud-agnostic.network private_network "Private application network" {
          cloud-agnostic.server portal_api "Project portal server"
          cloud-agnostic.database project_db "Project metadata"
          cloud-agnostic.cache metadata_cache "Project lookup cache"
        }
      }
    }
  }

  users -> edge { id portal_requests label "portal requests" step 1 }
  edge -> portal_api { id project_requests label "project requests" step 2 }
  project_db -> portal_api { id project_data label "project data" }
  metadata_cache -> portal_api { id lookup_cache label "cached lookups" }
  attachments -> portal_api { id file_objects label "project attachments" }
}
