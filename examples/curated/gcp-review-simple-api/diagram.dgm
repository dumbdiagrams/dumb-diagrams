dgm 1
diagram gcp-review-simple-api {
  grammar gcp
  flow lr
  title "Google Cloud customer API"

  cloud-agnostic.client client "Web client"

  gcp.organization organization "Google Cloud organization" {
    gcp.project project "Customer API project" {
      gcp.region region "Primary region" {
        gcp.cloud-load-balancing load_balancer "Cloud Load Balancing"
        gcp.cloud-run api "Customer API (Cloud Run)"
        gcp.cloud-sql database "Customer database (Cloud SQL)"
      }
    }
  }

  client -> load_balancer { id https_requests label "HTTPS requests" step 1 kind flow }
  load_balancer -> api { id api_requests step 2 kind flow }
  api -> database { id customer_data label "Read and write customers" step 3 kind flow }
}
