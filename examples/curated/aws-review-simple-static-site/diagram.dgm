dgm 1
diagram aws-review-simple-static-site {
  grammar aws
  flow lr
  title "AWS static website"

  cloud-agnostic.client visitor "Website visitor"

  aws.cloud aws_cloud "AWS Cloud" {
    cloud-agnostic.boundary web_delivery "Static website delivery" {
      aws.route-53 dns "Website DNS"
      aws.cloudfront cdn "Content delivery"
      aws.simple-storage-service site_bucket "Website files"
    }
  }

  visitor -> dns { id resolve_site label "look up site" }
  dns -> cdn { id open_site label "HTTPS request" }
  cdn -> site_bucket { id fetch_site label "static files" }
}
