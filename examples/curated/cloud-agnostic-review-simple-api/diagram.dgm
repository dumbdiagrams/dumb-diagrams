dgm 1
diagram cloud-agnostic-review-simple-api {
  grammar cloud-agnostic
  flow lr
  title "Cloud-agnostic customer API"

  cloud-agnostic.client client "Web client"

  cloud-agnostic.cloud cloud "Application cloud" {
    cloud-agnostic.account account "Production account" {
      cloud-agnostic.region region "Primary region" {
        cloud-agnostic.gateway gateway "API gateway"
        cloud-agnostic.server api "Customer API service"
        cloud-agnostic.database database "Customer database"
      }
    }
  }

  client -> gateway { id https_requests label "HTTPS requests" step 1 kind flow }
  gateway -> api { id api_requests step 2 kind flow }
  api -> database { id customer_data label "Read and write customers" step 3 kind flow }
}
