dgm 1
diagram azure-review-medium-iot-telemetry {
  grammar azure
  flow lr
  title "Azure IoT telemetry processing"

  cloud-agnostic.actor sensor_fleet "Industrial sensor fleet"
  cloud-agnostic.client operations_dashboard "Operations dashboard"

  azure.subscription subscription "Azure subscription" {
    azure.region region "Azure region" {
      azure.resource-group iot_group "IoT telemetry" {
        azure.iot-hub iot_hub "Telemetry IoT Hub"
        azure.event-hubs event_hubs "Telemetry Event Hubs"
        azure.function-apps processor "Telemetry processing function"
        azure.azure-cosmos-db status_db "Current equipment status"
        azure.storage-accounts raw_archive "Raw telemetry archive"
      }
    }
  }

  sensor_fleet -> iot_hub { id send_telemetry label "send telemetry" }
  iot_hub -> event_hubs { id route_to_stream label "route readings" }
  iot_hub -> raw_archive { id archive_readings label "archive raw readings" }
  event_hubs -> processor { id consume_stream label "consume event stream" }
  processor -> status_db { id write_status label "normalize and write status" }
  status_db -> operations_dashboard { id read_status label "read current status" }
}
