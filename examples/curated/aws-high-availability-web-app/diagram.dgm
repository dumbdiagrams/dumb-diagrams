dgm 1
diagram aws-high-availability-web-app {
  grammar aws
  flow lr
  title "Highly available AWS web application"

  cloud-agnostic.client browser "Web client"

  aws.cloud aws_cloud "AWS Cloud" {
    cloud-agnostic.boundary public_edge "Frontend services" {
      aws.route-53 dns
      aws.cognito identity "User authentication"
      aws.cloudfront cdn
      aws.simple-storage-service static_site "Static content"
    }

    aws.api-gateway gateway

    aws.vpc network "VPC" {
      aws.elastic-load-balancing-application-load-balancer load_balancer

      aws.az zone_one "Availability Zone A" {
        aws.subnet.private app_subnet_one "Private application subnet" {
          aws.elastic-container-service service_one "ECS service"
          aws.aws-fargate tasks_one "Fargate tasks" { role secondary }
        }
      }

      aws.az zone_two "Availability Zone B" {
        aws.subnet.private app_subnet_two "Private application subnet" {
          aws.elastic-container-service service_two "ECS service"
          aws.aws-fargate tasks_two "Fargate tasks" { role secondary }
        }
      }
    }

    cloud-agnostic.boundary platform_services "Shared platform services" {
      cloud-agnostic.boundary data_subnet_one "DynamoDB data services A" {
        aws.dynamodb table_one "DynamoDB table"
      }

      cloud-agnostic.boundary data_subnet_two "DynamoDB data services B" {
        aws.dynamodb table_two "DynamoDB table"
      }

      aws.cloudwatch monitoring "Application + database monitoring"
      aws.elastic-container-registry registry "Container images"
    }
  }

  browser -> dns { id request_dns step 1 from e to w }
  dns -> identity { id resolve_identity step 2 from s to n }
  identity -> cdn { id identity_to_cdn step 3 from s to n }
  cdn -> static_site { id static_origin label "static content" from s to n }
  cdn -> gateway { id cdn_to_api step 4 from e to w }
  identity -> gateway { id api_authorizer label "JWT authorizer" style dashed kind peer from e to s }
  gateway -> load_balancer { id api_to_alb step 5 from e to w }
  load_balancer -> service_one { id distribute_a step 6 from e to w }
  load_balancer -> service_two { id distribute_b from e to w }
  service_one -> tasks_one { id run_tasks_a style dashed kind peer from e to w }
  service_two -> tasks_two { id run_tasks_b style dashed kind peer from e to w }
  registry -> tasks_one { id pull_image_a label "container image" style dashed from e to n }
  registry -> tasks_two { id pull_image_b style dashed from e to n }
  tasks_one -> table_one { id read_data_a from e to w }
  tasks_two -> table_two { id read_data_b from e to w }
  tasks_one -> monitoring { id monitor_app_a style dashed kind peer from e to w }
  tasks_two -> monitoring { id monitor_app_b style dashed kind peer from e to w }
  table_one -> monitoring { id monitor_data_a style dashed kind peer from e to w }
  table_two -> monitoring { id monitor_data_b style dashed kind peer from e to w }
}
