dgm 1
diagram gcp-document-processing {
  grammar gcp
  flow lr
  title "Google Cloud document processing"

  cloud-agnostic.client partner "Partner"

  gcp.organization organization "Google Cloud organization" {
    gcp.project project "Document processing project" {
      gcp.region region "Primary region" {
        gcp.cloud-run intake "Cloud Run intake"
        gcp.cloud-storage source_bucket "Source bucket"
        gcp.pub-sub notifications "Pub/Sub"
        gcp.cloud-run processor "Cloud Run processor"
        gcp.cloud-storage output_bucket "Output bucket"
        gcp.cloud-sql metadata_db "Cloud SQL"
      }
    }
  }

  partner -> intake { id partner_to_intake step 1 label "upload documents" kind flow }
  intake -> source_bucket { id intake_to_source step 2 label "original files" kind flow }
  source_bucket -> notifications { id source_to_pubsub label "object notifications" kind flow }
  notifications -> processor { id pubsub_to_processor step 3 label "consume events" kind flow }
  processor -> source_bucket { id processor_reads_source label "read original" style dashed kind peer }
  processor -> output_bucket { id processor_to_output step 4 label "normalized output" kind flow }
  processor -> metadata_db { id processor_to_sql step 5 label "status and metadata" kind flow }
}
