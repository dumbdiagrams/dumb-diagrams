dgm 1
diagram gcp-customer-record-api {
  grammar gcp
  flow lr
  title "Google Cloud customer-record API"

  cloud-agnostic.client web_client "Web client"

  gcp.organization organization "Google Cloud organization" {
    gcp.project project "Customer records project" {
      gcp.region region "Primary region" {
        gcp.cloud-load-balancing load_balancer "Cloud Load Balancing"
        gcp.cloud-run api "Cloud Run API"
        gcp.cloud-sql database "Cloud SQL"
      }
    }
  }

  web_client -> load_balancer { id client_to_lb step 1 label "HTTPS requests" kind flow }
  load_balancer -> api { id lb_to_api step 2 kind flow }
  api -> database { id api_to_sql step 3 label "customer records" kind flow }
}
