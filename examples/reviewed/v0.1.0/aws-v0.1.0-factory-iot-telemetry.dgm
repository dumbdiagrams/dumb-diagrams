dgm 1
diagram aws-factory-iot-telemetry {
  grammar aws
  flow lr
  title "Factory IoT telemetry"

  cloud-agnostic.device sensor_fleet "Factory sensor fleet"
  cloud-agnostic.client dashboard "Operations dashboard"

  aws.cloud aws_cloud "AWS Cloud" {
    aws.aws-iot-core iot_core "AWS IoT Core"
    aws.kinesis-data-streams telemetry_stream "Kinesis Data Streams"
    aws.aws-lambda consumer "Lambda consumer"
    aws.timestream timestream "Amazon Timestream"
    aws.simple-notification-service alerts "Amazon SNS"
  }

  sensor_fleet -> iot_core { id sensors_to_iot step 1 label "readings" }
  iot_core -> telemetry_stream { id iot_to_kinesis step 2 label "route" }
  telemetry_stream -> consumer { id kinesis_to_lambda step 3 label "consume" }
  consumer -> timestream { id lambda_to_timestream step 4 label "time-series data" }
  consumer -> alerts { id lambda_to_sns step 5 label "threshold alerts" }
  timestream -> dashboard { id timestream_to_dashboard label "returned telemetry" }
}
