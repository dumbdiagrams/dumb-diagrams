dgm 1
diagram gcp-webhook-event-pipeline {
  grammar gcp
  flow lr
  title "Google Cloud webhook event pipeline"

  cloud-agnostic.client partner "Partner"

  gcp.organization organization "Google Cloud organization" {
    gcp.project project "Event-processing project" {
      gcp.region region "Primary region" {
        gcp.cloud-load-balancing load_balancer "Cloud Load Balancing"
        gcp.cloud-functions ingress "Ingress handler"
        gcp.pub-sub events "Pub/Sub topic"
        gcp.dataflow pipeline "Dataflow"
        gcp.bigquery warehouse "BigQuery"
        gcp.cloud-storage raw_archive "Cloud Storage"
      }
    }
  }

  partner -> load_balancer { id partner_to_lb step 1 label "webhook events" kind flow }
  load_balancer -> ingress { id lb_to_ingress step 2 kind flow }
  ingress -> events { id ingress_to_pubsub step 3 label "publish" kind flow }
  events -> pipeline { id pubsub_to_dataflow step 4 label "deliver events" kind flow }
  pipeline -> warehouse { id dataflow_to_bigquery step 5 label "processed records" kind flow }
  pipeline -> raw_archive { id dataflow_to_storage step 6 label "raw event files" kind flow }
}
