diagram aws-govcloud-public-connectivity {
  grammar aws
  flow lr
  title "Hybrid connectivity between AWS GovCloud (US) and commercial Regions"

  aws.cloud cloud "AWS Cloud" {
    aws.region commercial "Commercial Region" {
      aws.vpc vpc_a "VPC A — 10.0.0.0/16 — 2001:db8:1234:1a00::/56" {
        aws.subnet.private workload_a "Workload subnet — 10.0.0.0/24" {
          aws.ec2 commercial_ec2
        }
        aws.subnet.public public_a "Public subnet — 10.0.1.0/24" {
          aws.vpc-nat-gateway nat
        }
        aws.vpc-internet-gateway igw_a
      }
    }

    cloud-agnostic.cloud-resource internet "internet"

    aws.region govcloud "GovCloud Region" {
      aws.vpc vpc_b "VPC B — 10.1.0.0/16 — 2001:db8:1234:2b00::/56" {
        aws.subnet.private workload_b "Workload subnet — 10.1.0.0/24" {
          aws.ec2 govcloud_ec2
        }
        aws.subnet.public public_b "Public subnet — 10.1.1.0/24" {
          aws.elastic-load-balancing-application-load-balancer alb
        }
        aws.vpc-internet-gateway igw_b
      }
    }
  }

  commercial_ec2 -> nat { id outbound step 1 }
  nat -> igw_a
  igw_a -> internet { id public_path step 2 }
  internet -> igw_b
  igw_b -> alb { id inbound step 3 }
  alb -> govcloud_ec2
}

view default {
  place cloud { x 40 y 64 w 1500 h 590 pin }
  place commercial { x 76 y 106 w 560 h 500 pin }
  place vpc_a { x 108 y 148 w 500 h 420 pin }
  place workload_a { x 136 y 192 w 210 h 190 pin }
  place commercial_ec2 { x 186 y 250 pin }
  place public_a { x 370 y 192 w 210 h 190 pin }
  place nat { x 420 y 250 pin }
  place igw_a { x 500 y 454 pin }
  place internet { x 730 y 310 pin }
  place govcloud { x 930 y 106 w 560 h 500 pin }
  place vpc_b { x 962 y 148 w 500 h 420 pin }
  place workload_b { x 990 y 192 w 210 h 190 pin }
  place govcloud_ec2 { x 1040 y 250 pin }
  place public_b { x 1224 y 192 w 210 h 190 pin }
  place alb { x 1274 y 250 pin }
  place igw_b { x 990 y 454 pin }
}
