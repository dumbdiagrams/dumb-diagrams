diagram aws-site-to-site-vpn {
  grammar aws
  flow lr
  title "AWS Site-to-Site VPN to an Amazon VPC"

  aws.region region "AWS Region" {
    aws.vpc vpc "VPC 10.0.0.0/16" {
      aws.az az_a "Availability Zone A" {
        aws.subnet.private workload_a "workload subnet 1 — 10.0.0.0/24" {
          aws.ec2 ec2_a
        }
      }
      aws.az az_b "Availability Zone B" {
        aws.subnet.private workload_b "workload subnet 2 — 10.0.1.0/24" {
          aws.ec2 ec2_b "instances"
        }
      }
      aws.vpc-vpn-gateway private_gateway
    }
  }

  group dx_location "AWS Direct Connect location" {
    aws.aws-direct-connect dx_device "AWS device"
    aws.aws-direct-connect dx_partner "customer or partner device"
  }

  group corporate "corporate network — 192.168.0.0/16" {
    aws.vpc-customer-gateway customer_gateway
    cloud-agnostic.server server
    cloud-agnostic.client user
  }

  server -> customer_gateway { id traffic_a step 1 label "corporate traffic" }
  customer_gateway -> dx_partner { id direct_public step 2 label "Direct Connect public VIF" style dashed }
  dx_partner -> dx_device { id direct_link step 3 label "Direct Connect" style dashed }
  dx_device -> private_gateway { id vpn_tunnel step 4 label "IPSec VPN" style dashed }
  private_gateway -> ec2_a { id workload_route step 5 }
  private_gateway -> ec2_b { id workload_route_b }
}

view default {
  place region { x 48 y 72 w 620 h 520 pin }
  place vpc { x 76 y 112 w 560 h 440 pin }
  place az_a { x 104 y 152 w 220 h 310 pin }
  place workload_a { x 124 y 196 w 180 h 190 pin }
  place ec2_a { x 174 y 254 pin }
  place az_b { x 344 y 152 w 220 h 310 pin }
  place workload_b { x 364 y 196 w 180 h 190 pin }
  place ec2_b { x 414 y 254 pin }
  place private_gateway { x 540 y 462 pin }
  place dx_location { x 740 y 238 w 330 h 220 pin }
  place dx_device { x 780 y 302 pin }
  place dx_partner { x 952 y 302 pin }
  place customer_gateway { x 1140 y 302 pin }
  place corporate { x 1280 y 176 w 260 h 340 pin }
  place server { x 1330 y 260 pin }
  place user { x 1430 y 382 pin }
}
