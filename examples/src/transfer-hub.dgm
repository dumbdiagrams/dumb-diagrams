diagram transfer-hub {
  grammar aws
  flow lr

  generic.user user
  aws.cloud cloud "AWS Cloud" {
    aws.account customer "Customer's AWS Account" {
      generic.client ui
      group auth "Authentication" { aws.cognito cognito }
      aws.aws-appsync appsync
      aws.cloudfront cloudfront
      group workflow "AWS Step Functions workflow" {
        aws.aws-step-functions sfn
        aws.aws-lambda lambda1 "Workflow task"
        aws.aws-cloudformation cfn
      }
    }
    aws.account managed "AWS Managed Account" {
      aws.simple-storage-service s3_templates "Templates"
      aws.simple-storage-service s3_images "Images"
    }
  }

  user -> ui { id s1 step 1 }
  ui -> appsync { id s2 step 2 }
  appsync -> cloudfront { id s3 step 3 }
  cloudfront -> sfn { id s4 step 4 }
  sfn -> lambda1 { id s5 step 5 }
  lambda1 -> s3_templates { id s6 step 6 }
  cfn -> s3_images { id s7 step 7 }
  ui -> cognito { id s8 step 8 style dashed }
}

view default {
}
