diagram async-docs {
  grammar aws
  flow lr

  generic.user client "External Client"

  aws.region use1 "AWS Region (us-east-1)" {
    aws.vpc main "VPC" {
      aws.az azA "Availability Zone A" {
        aws.subnet.public pubA "Public Subnet A" {
          aws.alb api_alb "Document API ALB"
        }
        aws.subnet.private appA "Private App Subnet A" {
          aws.ecs apiA "Document API"
          aws.ecs workerA "Document worker"
        }
      }
      aws.az azB "Availability Zone B" {
        aws.subnet.public pubB "Public Subnet B" {
          aws.alb api_alb_b "Document API ALB"
        }
        aws.subnet.private appB "Private App Subnet B" {
          aws.ecs apiB "Document API"
          aws.ecs workerB "Document worker"
        }
      }
    }

    group queues "Async Queue Tier" {
      aws.sqs jobs "Processing queue"
      aws.sqs jobs_dlq "DLQ" { role secondary }
    }

    group storage "Storage Tier" {
      aws.s3 artifacts "Processed artifacts"
    }
  }

  client -> api_alb { step 1 }
  api_alb -> apiA
  apiA -> jobs
  jobs -> workerA
  workerA -> artifacts
  jobs -> jobs_dlq { style dashed kind fail }
}

view default {
}
