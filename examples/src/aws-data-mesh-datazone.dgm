diagram aws-data-mesh-datazone {
  grammar aws
  flow lr
  title "Data Mesh Reference Architecture with Amazon DataZone"

  group sources "Data sources" {
    step 1
    cloud-agnostic.database databases "SQL / NoSQL databases"
    cloud-agnostic.object-storage files "file shares"
    cloud-agnostic.device devices "devices"
    cloud-agnostic.observability logs "logs"
    cloud-agnostic.actor social "social"
    cloud-agnostic.cloud-resource saas "SaaS applications"
    cloud-agnostic.stream media "media"
  }

  group ingestion "Data ingestion" {
    step 2
    aws.appflow appflow
    aws.aws-database-migration-service dms
    aws.kinesis kinesis
    aws.aws-iot-core iot
    aws.managed-streaming-for-apache-kafka msk
  }

  aws.account producer "Member account 1 — data producer" {
    step 3
    group storage "Data storage" {
      aws.simple-storage-service s3
      aws.rds rds
      aws.redshift redshift
      cloud-agnostic.database third_party "third-party sources"
    }
    group processing "Data processing" {
      aws.aws-glue glue
      aws.aws-glue-data-quality quality
      aws.aws-glue-data-catalog producer_catalog
    }
  }

  aws.account governance "Central governance account" {
    step 4
    aws.datazone datazone "domain"
    aws.aws-iam-identity-center identity
    group portal "Amazon DataZone data portal" {
      aws.datazone-data-projects projects
      aws.datazone-business-data-catalog catalog
      cloud-agnostic.observability search "search and filter data products"
      cloud-agnostic.event subscription "data subscription workflow"
    }
  }

  aws.account consumer "Member account 1 — data consumer" {
    step 7
    aws.sagemaker sagemaker
    aws.aws-glue-data-catalog consumer_catalog
    group analytics "analytics and reporting" {
      aws.athena athena
      aws.redshift consumer_redshift
      aws.quick quicksight
    }
  }

  sources -> ingestion { id source_flow }
  ingestion -> producer { id ingest_flow }
  producer -> governance { id publish_flow }
  datazone -> projects { id portal_flow }
  projects -> search { id search_flow step 5 }
  catalog -> subscription { id subscribe_flow step 6 }
  governance -> consumer { id consume_flow }
}

view default {
  place sources { x 40 y 84 w 190 h 720 pin }
  place databases { x 84 y 138 pin }
  place files { x 84 y 220 pin }
  place devices { x 84 y 302 pin }
  place logs { x 84 y 384 pin }
  place social { x 84 y 466 pin }
  place saas { x 84 y 548 pin }
  place media { x 84 y 630 pin }
