dgm 1
diagram azure-private-order-processing {
  grammar azure
  flow lr
  title "Azure private order processing"

  cloud-agnostic.client public_client "Public client"
  cloud-agnostic.actor operations "Operations client"

  azure.subscription subscription "Azure subscription" {
    azure.region region "Azure region" {
      azure.resource-group resource_group "Resource group" {
        cloud-agnostic.boundary platform "Private order processing" {
          style dashed
          color blue
          fill none

          azure.front-door-and-cdn-profiles front_door { service "Azure Front Door" }
          azure.api-management-services apim { service "API Management" }

          azure.vnet vnet "Virtual network" {
            azure.subnet app_subnet "Application subnet" {
              azure.app-services api { service "App Service API" }
              azure.function-apps worker { service "Function worker" }
            }

            azure.subnet data_subnet "Data subnet" {
              azure.private-endpoints sql_pe { service "SQL private endpoint" }
              azure.private-endpoints storage_pe { service "Storage private endpoint" }
            }
          }

          azure.sql-database sql { service "Azure SQL Database" }
          azure.storage-accounts storage { service "Storage Account" }
          azure.azure-service-bus work_queue { service "Service Bus work queue" }
          azure.azure-service-bus dead_letter { service "Dead-letter queue" role secondary }
          azure.key-vaults key_vault { service "Key Vault" }
          azure.monitor monitor { service "Azure Monitor" }
        }
      }
    }
  }

  operations -> dead_letter { id ops_inspect_dlq label "inspect DLQ" style dashed kind peer }
  dead_letter -> work_queue { id dlq_redrive label "redrive" style dashed kind peer }

  public_client -> front_door { id client_to_fd step 1 label "HTTPS" kind flow }
  front_door -> apim { id fd_to_apim step 2 kind flow }
  apim -> api { id apim_to_api step 3 kind flow }
  api -> sql_pe { id api_to_sql_pe step 4 label "read and write orders" kind flow }
  sql_pe -> sql { id sql_pe_to_sql label "private link" kind flow }
  work_queue -> worker { id queue_to_worker step 5 label "consume work" kind flow }
  worker -> storage_pe { id worker_to_storage_pe step 6 kind flow }
  storage_pe -> storage { id storage_pe_to_storage label "private link" kind flow }
  work_queue -> dead_letter { id queue_to_dlq label "retry limit exceeded" style dashed kind fail }
}
