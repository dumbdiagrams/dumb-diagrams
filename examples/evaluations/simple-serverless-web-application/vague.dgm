dgm 1
diagram website_stack {
  grammar aws
  flow lr
  title "Serverless web application"

  cloud-agnostic.client browser "Browser"

  aws.cloud platform "AWS Cloud" {
    cloud-agnostic.boundary web "Web frontend" {
      aws.simple-storage-service bucket "Site assets"
      aws.cloudfront delivery "Content delivery"
    }

    aws.dynamodb store "Application data"
    aws.aws-lambda function "API handler"
    aws.api-gateway endpoint "HTTP API"
  }

  browser -> delivery
  delivery -> bucket { label "static content" }
  delivery -> endpoint
  endpoint -> function
  function -> store
}
