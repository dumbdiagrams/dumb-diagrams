{
  "$comment": "Reviewed reference for gcp-easy-customer-record-api.md. Roles match by catalog type, containment, and edge direction; see scripts/lib/reference-contract.mjs.",
  "grammar": "gcp",
  "exclusive": true,
  "roles": {
    "client": {
      "types": [
        "cloud-agnostic.actor",
        "cloud-agnostic.client",
        "cloud-agnostic.device"
      ],
      "outside": "organization"
    },
    "organization": {
      "types": [
        "gcp.organization"
      ]
    },
    "project": {
      "types": [
        "gcp.project"
      ],
      "within": "organization"
    },
    "region": {
      "types": [
        "gcp.region"
      ],
      "within": "project"
    },
    "lb": {
      "types": [
        "gcp.cloud-load-balancing"
      ],
      "within": "region"
    },
    "api": {
      "types": [
        "gcp.cloud-run"
      ],
      "within": "region"
    },
    "sql": {
      "types": [
        "gcp.cloud-sql"
      ],
      "within": "region"
    }
  },
  "edges": [
    "client -> lb",
    "lb -> api",
    "api -- sql"
  ]
}
