{
  "$schema": "../../.dumbdiagrams/requirements.schema.json",
  "version": 1,
  "grammar": "gcp",
  "components": [
    {"id":"org","kind":"group","type":"gcp.organization","basis":{"kind":"explicit","text":"Google Cloud organization"}},
    {"id":"project","kind":"group","type":"gcp.project","basis":{"kind":"explicit","text":"Nest the project"}},
    {"id":"region","kind":"group","type":"gcp.region","basis":{"kind":"explicit","text":"primary region"}},
    {"id":"partner","kind":"resource","type":"cloud-agnostic.actor","basis":{"kind":"explicit","text":"A partner uploads documents"}},
    {"id":"intake","kind":"resource","type":"gcp.cloud-run","basis":{"kind":"explicit","text":"Cloud Run intake service"}},
    {"id":"source-bucket","kind":"resource","type":"gcp.cloud-storage","basis":{"kind":"explicit","text":"Cloud Storage source bucket"}},
    {"id":"events","kind":"resource","type":"gcp.pub-sub","basis":{"kind":"explicit","text":"publish to Pub/Sub"}},
    {"id":"processor","kind":"resource","type":"gcp.cloud-run","basis":{"kind":"explicit","text":"a second Cloud Run service consumes those events"}},
    {"id":"normalized-bucket","kind":"resource","type":"gcp.cloud-storage","basis":{"kind":"explicit","text":"separate Cloud Storage bucket"}},
    {"id":"status-db","kind":"resource","type":"gcp.cloud-sql","basis":{"kind":"explicit","text":"Cloud SQL"}}
  ],
  "relationships": [
    {"id":"upload","source":"partner","target":"intake","basis":{"kind":"explicit","text":"partner uploads documents through a Cloud Run intake service"}},
    {"id":"store-original","source":"intake","target":"source-bucket","basis":{"kind":"explicit","text":"stores original files"}},
    {"id":"notify","source":"source-bucket","target":"events","basis":{"kind":"explicit","text":"Object notifications publish to Pub/Sub"}},
    {"id":"consume","source":"events","target":"processor","basis":{"kind":"explicit","text":"second Cloud Run service consumes those events"}},
    {"id":"read-original","source":"processor","target":"source-bucket","basis":{"kind":"explicit","text":"reads the original file"}},
    {"id":"store-normalized","source":"processor","target":"normalized-bucket","basis":{"kind":"explicit","text":"stores normalized output"}},
    {"id":"write-status","source":"processor","target":"status-db","basis":{"kind":"explicit","text":"writes processing status and metadata to Cloud SQL"}}
  ],
  "counts": [
    {"id":"cloud-run-count","kind":"resource","type":"gcp.cloud-run","min":2,"max":2,"basis":{"kind":"explicit","text":"a second Cloud Run service"}},
    {"id":"bucket-count","kind":"resource","type":"gcp.cloud-storage","min":2,"max":2,"basis":{"kind":"explicit","text":"source bucket ... separate bucket"}}
  ],
  "placement": [
    {"id":"project-in-org","component":"project","relation":"parent","group":"org","basis":{"kind":"explicit","text":"Nest the project ... inside a Google Cloud organization"}},
    {"id":"region-in-project","component":"region","relation":"parent","group":"project","basis":{"kind":"explicit","text":"project and primary region"}},
    {"id":"intake-in-region","component":"intake","relation":"inside","group":"region","basis":{"kind":"explicit","text":"all Google Cloud services in the region"}},
    {"id":"source-in-region","component":"source-bucket","relation":"inside","group":"region","basis":{"kind":"explicit","text":"all Google Cloud services in the region"}},
    {"id":"events-in-region","component":"events","relation":"inside","group":"region","basis":{"kind":"explicit","text":"all Google Cloud services in the region"}},
    {"id":"processor-in-region","component":"processor","relation":"inside","group":"region","basis":{"kind":"explicit","text":"all Google Cloud services in the region"}},
    {"id":"normalized-in-region","component":"normalized-bucket","relation":"inside","group":"region","basis":{"kind":"explicit","text":"all Google Cloud services in the region"}},
    {"id":"db-in-region","component":"status-db","relation":"inside","group":"region","basis":{"kind":"explicit","text":"all Google Cloud services in the region"}},
    {"id":"partner-outside","component":"partner","relation":"outside","group":"org","basis":{"kind":"explicit","text":"Keep the partner outside the organization"}}
  ],
  "allowAdditionalResources": false
}
