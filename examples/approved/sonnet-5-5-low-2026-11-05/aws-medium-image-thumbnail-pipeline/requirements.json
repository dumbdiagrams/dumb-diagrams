    {"id":"job_queue","kind":"resource","type":"aws.simple-queue-service","basis":{"kind":"explicit","text":"queues a thumbnail job"}},
    {"id":"processor","kind":"resource","type":"aws.aws-lambda","basis":{"kind":"explicit","text":"a processor creates a thumbnail"}},
