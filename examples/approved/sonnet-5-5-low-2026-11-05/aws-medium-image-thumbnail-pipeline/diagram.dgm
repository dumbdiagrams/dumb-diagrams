dgm 1
diagram aws-image-thumbnail-pipeline {
  grammar aws
  flow lr
  title "Image thumbnail pipeline"

  cloud-agnostic.actor uploader "Uploader"

  aws.cloud cloud "AWS Cloud" {
    aws.api-gateway api "Upload API"
    aws.aws-lambda upload_handler "Upload handler"
    aws.simple-storage-service-bucket original_bucket "Originals"
    aws.simple-queue-service job_queue "Thumbnail jobs"
    aws.aws-lambda processor "Processor"
    aws.simple-storage-service-bucket thumbnail_bucket "Thumbnails"
    aws.cloudfront cdn "CDN"
  }

  uploader -> api { id upload label "Upload" }
  api -> upload_handler { id invoke_handler }
  upload_handler -> original_bucket { id store_original label "Store" }
  upload_handler -> job_queue { id queue_job label "Queue" }
  job_queue -> processor { id consume_job }
  original_bucket -> processor { id read_original label "Read" }
  processor -> thumbnail_bucket { id store_thumbnail label "Store" }
  original_bucket -> cdn { id serve_original }
  thumbnail_bucket -> cdn { id serve_thumbnail }
}
