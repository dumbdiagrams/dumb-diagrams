dgm 1
diagram gcp-webhook-event-pipeline {
  grammar gcp
  flow lr
  title "Webhook Event Pipeline"
  cloud-agnostic.client partner "Partner"
  gcp.organization org "Organization" {
    gcp.project project "Event Processing" {
      gcp.region region "Primary Region" {
        gcp.cloud-load-balancing lb "Load Balancer"
        gcp.cloud-functions ingress "Ingress Handler"
        gcp.pub-sub topic "Events"
        gcp.dataflow dataflow "Processing"
        gcp.bigquery bq "Records"
        gcp.cloud-storage raw "Raw Events"
      }
    }
  }
  partner -> lb { id webhook label "Webhooks" }
  lb -> ingress { id route }
  ingress -> topic { id publish label "Publish" }
  topic -> dataflow { id deliver }
  dataflow -> bq { id records label "Processed" }
  dataflow -> raw { id archive label "Raw" }
}
