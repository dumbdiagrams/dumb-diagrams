dgm 1
diagram cloud-agnostic-order-processing {
  grammar cloud-agnostic
  flow lr
  title "Order Processing with Recovery Region"

  cloud-agnostic.actor buyer "Buyer"
  cloud-agnostic.cloud-resource payment "Payment Service"
  cloud-agnostic.cloud-resource warehouse "Warehouse"

  cloud-agnostic.cloud cloud "Cloud" {
    cloud-agnostic.account account "Account" {
      cloud-agnostic.region primary_region "Primary Region" {
        cloud-agnostic.load-balancer primary_lb "Load Balancer"

        cloud-agnostic.network primary_network "Primary Network" {
          cloud-agnostic.cluster app_cluster "Application Cluster" {
            cloud-agnostic.server api "API"
            cloud-agnostic.server worker "Worker"
          }

          cloud-agnostic.database database "Database"
          cloud-agnostic.cache cache "Cache"
        }

        cloud-agnostic.queue queue "Queue"
        cloud-agnostic.object-storage receipts "Receipts"
      }

      cloud-agnostic.region recovery_region "Recovery Region" {
        cloud-agnostic.load-balancer recovery_lb "Recovery LB"

        cloud-agnostic.network recovery_network "Recovery Network" {
          cloud-agnostic.server recovery_app "Recovery App"
          cloud-agnostic.database recovery_db "Replica"
        }
      }
    }
  }

  buyer -> primary_lb { id buyer_to_lb }
  primary_lb -> api { id lb_to_api }
  api -> database { id api_to_db }
  database -> api { id db_to_api }
  api -> cache { id api_to_cache }
  cache -> api { id cache_to_api }
  api -> payment { id api_to_payment }
  payment -> api { id payment_to_api }
  api -> queue { id api_to_queue }
  queue -> worker { id queue_to_worker }
  worker -> warehouse { id worker_to_warehouse }
  warehouse -> worker { id warehouse_to_worker }
  worker -> queue { id worker_retry label "retry" kind fail }
  worker -> database { id worker_to_db }
  worker -> receipts { id worker_to_receipts }
  database -> recovery_db { id db_replication label "replicate" }
  recovery_app -> recovery_db { id recovery_reads }
  buyer -> recovery_lb { id buyer_to_recovery_lb }
  recovery_lb -> recovery_app { id recovery_lb_to_app }
}
