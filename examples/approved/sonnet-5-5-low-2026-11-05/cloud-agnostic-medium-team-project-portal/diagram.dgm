dgm 1
diagram cloud-agnostic-team-project-portal {
  grammar cloud-agnostic
  flow lr
  title "Team Project Portal"

  cloud-agnostic.actor users "Users"

  cloud-agnostic.cloud cloud "Cloud" {
    cloud-agnostic.load-balancer lb "Load Balancer"

    cloud-agnostic.network private_net "Private Network" {
      cloud-agnostic.server portal "Portal Server"
      cloud-agnostic.database db "Project Data"
      cloud-agnostic.cache cache "Cache"
    }

    cloud-agnostic.object-storage files "Attachments"
  }

  users -> lb { id users_to_lb }
  lb -> portal { id lb_to_portal }
  portal -> db { id portal_to_db label "reads" }
  portal -> cache { id portal_to_cache label "lookups" }
  portal -> files { id portal_to_files label "attachments" }
}
