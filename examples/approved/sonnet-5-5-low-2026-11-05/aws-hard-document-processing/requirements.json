{
  "$schema": "../../.dumbdiagrams/requirements.schema.json",
  "version": 1,
  "grammar": "aws",
  "components": [
    {"id":"cloud","kind":"group","type":"aws.cloud","basis":{"kind":"explicit","text":"Show one cloud"}},
    {"id":"region","kind":"group","type":"aws.region","basis":{"kind":"explicit","text":"one region"}},
    {"id":"vpc","kind":"group","type":"aws.vpc","basis":{"kind":"explicit","text":"one VPC"}},
    {"id":"az_a","kind":"group","type":"aws.az","basis":{"kind":"explicit","text":"two AZs"}},
    {"id":"az_b","kind":"group","type":"aws.az","basis":{"kind":"explicit","text":"two AZs"}},
    {"id":"subnet_a","kind":"group","type":"aws.subnet.private","basis":{"kind":"explicit","text":"one private subnet group per AZ"}},
    {"id":"subnet_b","kind":"group","type":"aws.subnet.private","basis":{"kind":"explicit","text":"one private subnet group per AZ"}},
    {"id":"client","kind":"resource","type":"cloud-agnostic.client","basis":{"kind":"explicit","text":"document intake client"}},
    {"id":"ops","kind":"resource","type":"cloud-agnostic.actor","basis":{"kind":"explicit","text":"an operations user"}},
    {"id":"api","kind":"resource","type":"aws.api-gateway","basis":{"kind":"explicit","text":"through API Gateway"}},
    {"id":"intake","kind":"resource","type":"aws.aws-lambda","basis":{"kind":"explicit","text":"Lambda intake handler"}},
    {"id":"input","kind":"resource","type":"aws.simple-storage-service-bucket","basis":{"kind":"explicit","text":"input S3 bucket"}},
    {"id":"jobs","kind":"resource","type":"aws.simple-queue-service-queue","basis":{"kind":"explicit","text":"queues jobs in SQS"}},
    {"id":"dlq","kind":"resource","type":"aws.simple-queue-service-queue","basis":{"kind":"explicit","text":"dead-letter queue"}},
    {"id":"worker_a","kind":"resource","type":"aws.aws-fargate","basis":{"kind":"explicit","text":"two Fargate workers"}},
    {"id":"worker_b","kind":"resource","type":"aws.aws-fargate","basis":{"kind":"explicit","text":"two Fargate workers"}},
    {"id":"output","kind":"resource","type":"aws.simple-storage-service-bucket","basis":{"kind":"explicit","text":"output S3"}},
    {"id":"ddb","kind":"resource","type":"aws.dynamodb","basis":{"kind":"explicit","text":"update DynamoDB status"}},
    {"id":"sns","kind":"resource","type":"aws.simple-notification-service","basis":{"kind":"explicit","text":"publish completion to SNS"}},
    {"id":"cdn","kind":"resource","type":"aws.cloudfront","basis":{"kind":"explicit","text":"through CloudFront"}}
  ],
  "relationships": [
    {"id":"submit","source":"client","target":"api","basis":{"kind":"explicit","text":"submits documents through API Gateway"}},
    {"id":"invoke","source":"api","target":"intake","basis":{"kind":"explicit","text":"to a Lambda intake handler"}},
    {"id":"store","source":"intake","target":"input","basis":{"kind":"explicit","text":"stores originals in an input S3 bucket"}},
    {"id":"enqueue","source":"intake","target":"jobs","basis":{"kind":"explicit","text":"queues jobs in SQS"}},
    {"id":"consume_a","source":"jobs","target":"worker_a","basis":{"kind":"explicit","text":"consumed by two Fargate workers"}},
    {"id":"consume_b","source":"jobs","target":"worker_b","basis":{"kind":"explicit","text":"consumed by two Fargate workers"}},
    {"id":"read_a","source":"input","target":"worker_a","basis":{"kind":"explicit","text":"Both workers read input S3"}},
    {"id":"read_b","source":"input","target":"worker_b","basis":{"kind":"explicit","text":"Both workers read input S3"}},
    {"id":"write_a","source":"worker_a","target":"output","basis":{"kind":"explicit","text":"write processed files to output S3"}},
    {"id":"write_b","source":"worker_b","target":"output","basis":{"kind":"explicit","text":"write processed files to output S3"}},
    {"id":"status_a","source":"worker_a","target":"ddb","basis":{"kind":"explicit","text":"update DynamoDB status"}},
    {"id":"status_b","source":"worker_b","target":"ddb","basis":{"kind":"explicit","text":"update DynamoDB status"}},
    {"id":"publish_a","source":"worker_a","target":"sns","basis":{"kind":"explicit","text":"publish completion to SNS"}},
    {"id":"publish_b","source":"worker_b","target":"sns","basis":{"kind":"explicit","text":"publish completion to SNS"}},
    {"id":"download","source":"client","target":"cdn","basis":{"kind":"explicit","text":"client -> CloudFront"}},
    {"id":"origin","source":"cdn","target":"output","basis":{"kind":"explicit","text":"CloudFront -> output S3 origin"}},
    {"id":"fail","source":"jobs","target":"dlq","basis":{"kind":"explicit","text":"Failed jobs move to a dead-letter queue"}},
    {"id":"inspect_dlq","source":"ops","target":"dlq","basis":{"kind":"explicit","text":"operations user inspects the dead-letter queue"}},
    {"id":"inspect_ddb","source":"ops","target":"ddb","basis":{"kind":"explicit","text":"inspects ... DynamoDB"}},
    {"id":"redrive","source":"dlq","target":"jobs","basis":{"kind":"explicit","text":"redrive messages from the DLQ to the jobs queue"}},
    {"id":"notify","source":"sns","target":"ops","basis":{"kind":"explicit","text":"SNS sends completion notifications to operations"}}
  ],
  "counts": [
    {"id":"two_workers","kind":"resource","type":"aws.aws-fargate","min":2,"max":2,"basis":{"kind":"explicit","text":"two Fargate workers"}},
    {"id":"two_azs","kind":"group","type":"aws.az","min":2,"max":2,"within":"vpc","basis":{"kind":"explicit","text":"two AZs"}},
    {"id":"two_subnets","kind":"group","type":"aws.subnet.private","min":2,"max":2,"within":"vpc","basis":{"kind":"explicit","text":"one private subnet group per AZ"}}
  ],
  "placement": [
    {"id":"region_in_cloud","component":"region","relation":"parent","group":"cloud","basis":{"kind":"explicit","text":"one cloud, one region"}},
    {"id":"vpc_in_region","component":"vpc","relation":"parent","group":"region","basis":{"kind":"explicit","text":"one region, one VPC"}},
    {"id":"az_a_in_vpc","component":"az_a","relation":"parent","group":"vpc","basis":{"kind":"explicit","text":"one VPC, two AZs"}},
    {"id":"az_b_in_vpc","component":"az_b","relation":"parent","group":"vpc","basis":{"kind":"explicit","text":"one VPC, two AZs"}},
    {"id":"subnet_a_in_az","component":"subnet_a","relation":"parent","group":"az_a","basis":{"kind":"explicit","text":"private subnet per AZ"}},
    {"id":"subnet_b_in_az","component":"subnet_b","relation":"parent","group":"az_b","basis":{"kind":"explicit","text":"private subnet per AZ"}},
    {"id":"worker_a_in_subnet","component":"worker_a","relation":"parent","group":"subnet_a","basis":{"kind":"explicit","text":"each in a private subnet"}},
    {"id":"worker_b_in_subnet","component":"worker_b","relation":"parent","group":"subnet_b","basis":{"kind":"explicit","text":"each in a private subnet"}},
    {"id":"client_out","component":"client","relation":"root","basis":{"kind":"explicit","text":"Keep clients outside AWS"}},
    {"id":"ops_out","component":"ops","relation":"root","basis":{"kind":"explicit","text":"operations user outside AWS"}},
    {"id":"api_out","component":"api","relation":"outside","group":"vpc","basis":{"kind":"explicit","text":"managed services outside the VPC"}},
    {"id":"input_out","component":"input","relation":"outside","group":"vpc","basis":{"kind":"explicit","text":"managed services outside the VPC"}},
    {"id":"output_out","component":"output","relation":"outside","group":"vpc","basis":{"kind":"explicit","text":"managed services outside the VPC"}},
    {"id":"jobs_out","component":"jobs","relation":"outside","group":"vpc","basis":{"kind":"explicit","text":"managed services outside the VPC"}},
    {"id":"dlq_out","component":"dlq","relation":"outside","group":"vpc","basis":{"kind":"explicit","text":"managed services outside the VPC"}},
    {"id":"ddb_out","component":"ddb","relation":"outside","group":"vpc","basis":{"kind":"explicit","text":"managed services outside the VPC"}},
    {"id":"sns_out","component":"sns","relation":"outside","group":"vpc","basis":{"kind":"explicit","text":"managed services outside the VPC"}},
    {"id":"cdn_out","component":"cdn","relation":"outside","group":"vpc","basis":{"kind":"explicit","text":"managed services outside the VPC"}}
  ],
  "allowAdditionalResources": false
}
