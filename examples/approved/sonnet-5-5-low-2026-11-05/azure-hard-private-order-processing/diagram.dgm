dgm 1
diagram azure-private-order-processing {
  grammar azure
  flow lr
  title "Azure Private Order Processing"

  cloud-agnostic.client client "Public client"
  cloud-agnostic.client ops "Operations client"

  azure.subscription sub "Subscription" {
    azure.region region "Region" {
      azure.resource-group rg "Resource group" {
        azure.front-door-and-cdn-profiles front_door "Front Door"
        azure.api-management-services apim "API Management"

        azure.vnet vnet "VNet" {
          azure.subnet app_subnet "Application subnet" {
            azure.app-services api "API"
            azure.function-apps worker "Worker"
          }

          azure.subnet data_subnet "Data subnet" {
            azure.private-endpoints pe_sql "SQL endpoint"
            azure.private-endpoints pe_storage "Storage endpoint"
          }
        }

        azure.azure-service-bus service_bus "Work queue"
        cloud-agnostic.queue dlq "Dead-letter queue"
        azure.sql-database sql "SQL"
        azure.storage-accounts storage "Storage"
        azure.key-vaults key_vault "Key Vault"
        azure.monitor monitor "Monitor"
      }
    }
  }

  client -> front_door { id client_to_fd }
  front_door -> apim { id fd_to_apim }
  apim -> api { id apim_to_api }
  api -> pe_sql { id api_to_pe_sql label "read/write" }
  pe_sql -> sql { id pe_sql_to_sql }
  api -> service_bus { id api_to_bus label "enqueue" }
  service_bus -> worker { id bus_to_worker label "consume" }
  worker -> pe_storage { id worker_to_pe_storage label "files" }
  pe_storage -> storage { id pe_storage_to_storage }
  worker -> pe_sql { id worker_to_pe_sql label "status" }
  api -> key_vault { id api_to_kv style dashed kind peer }
  worker -> key_vault { id worker_to_kv style dashed kind peer }
  api -> monitor { id api_to_monitor style dashed kind peer }
  worker -> monitor { id worker_to_monitor style dashed kind peer }
  service_bus -> dlq { id bus_to_dlq label "retry limit" kind fail }
  ops -> dlq { id ops_inspect_dlq label "inspect" }
  ops -> service_bus { id ops_redrive label "redrive" }
}
