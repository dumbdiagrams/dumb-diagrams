dgm 1
diagram aws-static-website-delivery {
  grammar aws
  flow lr
  title "AWS Static Website Delivery"

  cloud-agnostic.actor visitor "Visitor"

  aws.cloud cloud "AWS Cloud" {
    aws.route-53 dns "DNS"
    aws.cloudfront cdn "CDN"
    aws.simple-storage-service-bucket bucket "Website files"
  }

  visitor -> dns { id visitor_dns label "Resolve" }
  dns -> cdn { id dns_cdn label "Route" }
  cdn -> bucket { id cdn_bucket label "Fetch" }
}
