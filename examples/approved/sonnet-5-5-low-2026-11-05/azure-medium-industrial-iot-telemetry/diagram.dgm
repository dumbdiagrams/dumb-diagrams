dgm 1
diagram azure-industrial-iot-telemetry {
  grammar azure
  flow lr
  title "Industrial IoT Telemetry"
  cloud-agnostic.device sensors "Sensor Fleet"
  azure.subscription subscription "Subscription" {
    azure.region region "Region" {
      azure.resource-group rg "Resource Group" {
        azure.iot-hub iothub "IoT Hub"
        azure.event-hubs eventhubs "Event Hubs"
        azure.storage-accounts archive "Raw Archive"
        azure.function-apps func "Normalizer"
        azure.azure-cosmos-db cosmos "Equipment Status"
      }
    }
  }
  cloud-agnostic.client dashboard "Operations Dashboard"
  sensors -> iothub { id send label "readings" }
  iothub -> eventhubs { id route_stream label "stream" }
  iothub -> archive { id route_archive label "archive" }
  eventhubs -> func { id consume label "consume" }
  func -> cosmos { id write_status label "status" }
  dashboard -> cosmos { id read_status label "reads" }
}
