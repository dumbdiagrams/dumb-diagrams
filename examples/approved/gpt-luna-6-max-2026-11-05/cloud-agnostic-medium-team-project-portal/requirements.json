    {
      "id": "lookup_cache",
      "kind": "resource",
      "type": "cloud-agnostic.cache",
      "basis": {
        "kind": "explicit",
        "text": "The server uses a cache for frequent lookups."
      }
    },
    {
      "id": "attachment_storage",
      "kind": "resource",
      "type": "cloud-agnostic.object-storage",
      "basis": {
        "kind": "explicit",
        "text": "The server retrieves attachments from object storage."
      }
    }
