{
  "$schema": "../../.dumbdiagrams/requirements.schema.json",
  "version": 1,
  "grammar": "cloud-agnostic",
  "components": [
    {
      "id": "application_cloud",
      "kind": "group",
      "type": "cloud-agnostic.cloud",
      "basis": {
        "kind": "inferred",
        "text": "The catalog requires a parent for a private network boundary, so a provider-neutral cloud scope supplies the minimal context."
      }
    },
    {
      "id": "private_network",
      "kind": "group",
      "type": "cloud-agnostic.network",
      "basis": {
        "kind": "explicit",
        "text": "The server, database, and cache are kept in a private network."
      }
    },
    {
      "id": "team_users",
      "kind": "resource",
      "type": "cloud-agnostic.client",
      "basis": {
        "kind": "explicit",
        "text": "Users reach the portal."
      }
    },
    {
      "id": "load_balancer",
      "kind": "resource",
      "type": "cloud-agnostic.load-balancer",
      "basis": {
        "kind": "explicit",
        "text": "Users reach a load balancer."
      }
    },
    {
      "id": "portal_server",
      "kind": "resource",
      "type": "cloud-agnostic.server",
      "basis": {
        "kind": "explicit",
        "text": "The load balancer forwards requests to a portal server."
      }
    },
    {
      "id": "project_database",
      "kind": "resource",
      "type": "cloud-agnostic.database",
      "basis": {
        "kind": "explicit",
        "text": "The server reads project data from a database."
