{
  "$schema": "../../.dumbdiagrams/requirements.schema.json",
  "version": 1,
  "grammar": "cloud-agnostic",
  "components": [
    {
      "id": "external_parties",
      "kind": "group",
      "type": "cloud-agnostic.boundary",
      "basis": {
        "kind": "inferred",
        "text": "The buyer, payment service, and warehouse are grouped outside the application cloud to separate actors from infrastructure."
      }
    },
    {
      "id": "application_cloud",
      "kind": "group",
      "type": "cloud-agnostic.cloud",
      "basis": {
        "kind": "explicit",
        "text": "One cloud account contains the primary and recovery regions."
      }
    },
    {
      "id": "cloud_account",
      "kind": "group",
      "type": "cloud-agnostic.account",
      "basis": {
        "kind": "explicit",
        "text": "One cloud account contains both regions."
      }
    },
    {
      "id": "primary_region",
      "kind": "group",
      "type": "cloud-agnostic.region",
      "basis": {
        "kind": "explicit",
        "text": "The primary region is in the account."
      }
    },
    {
      "id": "primary_network",
      "kind": "group",
      "type": "cloud-agnostic.network",
      "basis": {
        "kind": "explicit",
        "text": "The API server, database, and cache are in the primary private application network."
      }
    },
    {
      "id": "primary_cluster",
      "kind": "group",
      "type": "cloud-agnostic.cluster",
      "basis": {
        "kind": "explicit",
        "text": "The API server and worker are in the application cluster inside the primary network."
      }
    },
    {
      "id": "recovery_region",
      "kind": "group",
      "type": "cloud-agnostic.region",
      "basis": {
        "kind": "explicit",
        "text": "The recovery region is in the same account."
      }
    },
    {
      "id": "recovery_network",
      "kind": "group",
      "type": "cloud-agnostic.network",
      "basis": {
        "kind": "explicit",
        "text": "The recovery database is inside a recovery network."
      }
    },
    {
      "id": "buyer",
      "kind": "resource",
      "type": "cloud-agnostic.client",
      "basis": {
        "kind": "explicit",
        "text": "A public buyer reaches the regional load balancer and can be served through the recovery load balancer."
      }
    },
    {
      "id": "payment_service",
      "kind": "resource",
      "type": "cloud-agnostic.actor",
      "basis": {
        "kind": "explicit",
        "text": "The API calls an external payment service."
      }
    },
    {
      "id": "warehouse",
      "kind": "resource",
      "type": "cloud-agnostic.actor",
      "basis": {
        "kind": "explicit",
        "text": "The worker sends fulfillment to an external warehouse and receives its acknowledgment."
      }
    },
    {
      "id": "primary_lb",
      "kind": "resource",
      "type": "cloud-agnostic.load-balancer",
      "basis": {
        "kind": "explicit",
        "text": "A buyer reaches a regional load balancer in the primary region."
      }
    },
    {
      "id": "api_server",
      "kind": "resource",
      "type": "cloud-agnostic.server",
      "basis": {
        "kind": "explicit",
        "text": "The load balancer forwards requests to an API server in the private application network and cluster."
      }
    },
    {
      "id": "primary_database",
      "kind": "resource",
      "type": "cloud-agnostic.database",
      "basis": {
        "kind": "explicit",
        "text": "The database is in the primary private network and receives order status and replicates to recovery."
      }
    },
    {
      "id": "primary_cache",
      "kind": "resource",
      "type": "cloud-agnostic.cache",
      "basis": {
        "kind": "explicit",
        "text": "The cache is in the same primary private network."
      }
    },
    {
      "id": "work_queue",
      "kind": "resource",
      "type": "cloud-agnostic.queue",
      "basis": {
        "kind": "explicit",
        "text": "The API enqueues work in a regional queue outside the network."
      }
    },
    {
      "id": "worker_server",
      "kind": "resource",
      "type": "cloud-agnostic.server",
      "basis": {
        "kind": "explicit",
        "text": "A worker server in the application cluster consumes queued work."
      }
    },
    {
      "id": "receipt_storage",
      "kind": "resource",
      "type": "cloud-agnostic.object-storage",
      "basis": {
        "kind": "explicit",
        "text": "The worker writes receipts to object storage outside the network."
      }
    },
    {
      "id": "recovery_database",
      "kind": "resource",
      "type": "cloud-agnostic.database",
      "basis": {
        "kind": "explicit",
        "text": "The primary database replicates to a recovery database inside a recovery network."
      }
    },
    {
      "id": "recovery_app",
      "kind": "resource",
      "type": "cloud-agnostic.server",
      "basis": {
        "kind": "explicit",
        "text": "A recovery application server reads that replica."
      }
    },
    {
      "id": "recovery_lb",
      "kind": "resource",
      "type": "cloud-agnostic.load-balancer",
      "basis": {
        "kind": "explicit",
        "text": "The recovery application server can serve the buyer through a recovery load balancer."
      }
    }
  ],
  "relationships": [
    {
      "id": "buyer_primary",
      "source": "buyer",
      "target": "primary_lb",
      "basis": {
        "kind": "explicit",
        "text": "The public buyer reaches the primary regional load balancer."
      },
      "kind": "flow"
    },
    {
      "id": "primary_lb_api",
      "source": "primary_lb",
      "target": "api_server",
      "basis": {
        "kind": "explicit",
        "text": "The primary load balancer forwards requests to the API server."
      },
      "kind": "flow"
    },
    {
      "id": "api_db_request",
      "source": "api_server",
      "target": "primary_database",
      "basis": {
        "kind": "explicit",
        "text": "The API uses the primary database."
      },
      "kind": "flow"
    },
    {
      "id": "db_api_response",
      "source": "primary_database",
      "target": "api_server",
      "basis": {
        "kind": "explicit",
        "text": "Show a separate database response arrow back to the API."
      },
      "kind": "flow"
    },
    {
      "id": "api_cache_request",
      "source": "api_server",
      "target": "primary_cache",
      "basis": {
        "kind": "explicit",
        "text": "The API uses the cache."
      },
      "kind": "flow"
    },
    {
      "id": "cache_api_response",
      "source": "primary_cache",
      "target": "api_server",
      "basis": {
        "kind": "explicit",
        "text": "Show a separate cache response arrow back to the API."
      },
      "kind": "flow"
    },
    {
      "id": "api_payment_request",
      "source": "api_server",
      "target": "payment_service",
      "basis": {
        "kind": "explicit",
        "text": "The API calls the external payment service."
      },
      "kind": "flow"
    },
    {
      "id": "payment_api_response",
      "source": "payment_service",
      "target": "api_server",
      "basis": {
        "kind": "explicit",
        "text": "Show a separate payment response arrow back to the API."
      },
      "kind": "flow"
    },
    {
      "id": "api_to_queue",
      "source": "api_server",
      "target": "work_queue",
      "basis": {
        "kind": "explicit",
        "text": "The API enqueues work in a regional queue outside the network."
      },
      "kind": "flow"
    },
    {
      "id": "queue_to_worker",
      "source": "work_queue",
      "target": "worker_server",
      "basis": {
        "kind": "explicit",
        "text": "The queue feeds a worker server in the application cluster."
      },
      "kind": "flow"
    },
    {
      "id": "worker_to_warehouse",
      "source": "worker_server",
      "target": "warehouse",
      "basis": {
        "kind": "explicit",
        "text": "The worker sends fulfillment to an external warehouse."
      },
      "kind": "flow"
    },
    {
      "id": "warehouse_ack",
      "source": "warehouse",
      "target": "worker_server",
      "basis": {
        "kind": "explicit",
        "text": "The worker receives the warehouse acknowledgment."
      },
      "kind": "flow"
    },
    {
      "id": "worker_status",
      "source": "worker_server",
      "target": "primary_database",
      "basis": {
        "kind": "explicit",
        "text": "The worker writes order status to the primary database."
      },
      "kind": "flow"
    },
    {
      "id": "worker_receipt",
      "source": "worker_server",
      "target": "receipt_storage",
      "basis": {
        "kind": "explicit",
        "text": "The worker writes receipts to object storage outside the network."
      },
      "kind": "flow"
    },
    {
      "id": "worker_retry",
      "source": "worker_server",
      "target": "work_queue",
      "basis": {
        "kind": "explicit",
        "text": "The worker retries by sending work back to the queue."
      },
      "kind": "fail"
    },
    {
      "id": "database_replication",
      "source": "primary_database",
      "target": "recovery_database",
      "basis": {
        "kind": "explicit",
        "text": "The primary database replicates to the recovery database."
      },
      "kind": "flow"
    },
    {
      "id": "recovery_read",
      "source": "recovery_database",
      "target": "recovery_app",
      "basis": {
        "kind": "explicit",
        "text": "The recovery application server reads the recovery database replica."
      },
      "kind": "flow"
    },
    {
      "id": "buyer_recovery",
      "source": "buyer",
      "target": "recovery_lb",
      "basis": {
        "kind": "explicit",
        "text": "The recovery application can serve the buyer through a recovery load balancer."
      },
      "kind": "flow"
    },
    {
      "id": "recovery_lb_app",
      "source": "recovery_lb",
      "target": "recovery_app",
      "basis": {
        "kind": "explicit",
        "text": "The recovery load balancer forwards the buyer request to recovery application."
      },
      "kind": "flow"
    },
    {
      "id": "recovery_app_lb",
      "source": "recovery_app",
      "target": "recovery_lb",
      "basis": {
        "kind": "inferred",
        "text": "A serving path returns the recovery application response through its load balancer."
      },
      "kind": "flow"
    },
    {
      "id": "recovery_to_buyer",
      "source": "recovery_lb",
      "target": "buyer",
      "basis": {
        "kind": "inferred",
        "text": "The recovery load balancer returns the served response to the buyer."
      },
      "kind": "flow"
    }
  ],
  "counts": [
    {
      "id": "one_external_parties",
      "kind": "group",
      "type": "cloud-agnostic.boundary",
      "min": 1,
      "max": 1,
      "basis": {
        "kind": "inferred",
        "text": "One logical group for external actors."
      }
    },
    {
      "id": "one_cloud",
      "kind": "group",
      "type": "cloud-agnostic.cloud",
      "min": 1,
      "max": 1,
