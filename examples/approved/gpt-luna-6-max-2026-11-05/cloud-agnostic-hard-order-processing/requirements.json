      "within": "primary_region",
      "basis": {
        "kind": "explicit",
        "text": "Receipt object storage."
      }
    },
    {
      "id": "two_external_actors",
      "kind": "resource",
      "type": "cloud-agnostic.actor",
      "min": 2,
      "max": 2,
      "basis": {
        "kind": "explicit",
        "text": "One external payment service and one external warehouse."
      }
    }
  ],
