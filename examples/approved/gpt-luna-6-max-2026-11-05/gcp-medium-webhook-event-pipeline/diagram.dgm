dgm 1
diagram gcp-medium-webhook-event-pipeline {
  grammar gcp
  flow lr
  title "GCP Webhook Event Pipeline"
  gcp.organization organization "Google Cloud Organization" {
    gcp.project project "Event Processing Project" {
      gcp.region region "Primary Region" {
        gcp.cloud-load-balancing load_balancing "Cloud Load Balancing" {}
        gcp.cloud-functions ingress "Cloud Functions Ingress" {}
        gcp.pub-sub topic "Pub/Sub Topic" {}
        gcp.dataflow dataflow "Dataflow" {}
        gcp.bigquery bigquery "BigQuery" {}
        gcp.cloud-storage raw_storage "Cloud Storage Raw Events" {}
      }
    }
  }
  cloud-agnostic.actor partner "Partner" {}
  partner -> load_balancing { id send_webhook label "webhook event" step 1 }
  load_balancing -> ingress { id forward_to_ingress label "forward event" step 2 }
  ingress -> topic { id publish_event label "publish event" step 3 }
  topic -> dataflow { id stream_to_dataflow label "process events" step 4 }
  dataflow -> bigquery { id write_records label "processed records" step 5 }
  dataflow -> raw_storage { id write_raw_files label "raw event files" step 5 }
}
