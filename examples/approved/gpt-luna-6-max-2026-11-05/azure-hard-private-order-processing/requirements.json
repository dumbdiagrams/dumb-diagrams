{
  "$schema": "../../.dumbdiagrams/requirements.schema.json",
  "version": 1,
  "grammar": "azure",
  "components": [
    {
      "id": "azure-cloud",
      "kind": "group",
      "type": "cloud-agnostic.cloud",
      "basis": {
        "kind": "explicit",
        "text": "Show one cloud, one subscription, one region, and one resource group."
      }
    },
    {
      "id": "subscription",
      "kind": "group",
      "type": "azure.subscription",
      "basis": {
        "kind": "explicit",
        "text": "one subscription."
      }
    },
    {
      "id": "region",
      "kind": "group",
      "type": "azure.region",
      "basis": {
        "kind": "explicit",
        "text": "one region."
      }
    },
    {
      "id": "resource-group",
      "kind": "group",
      "type": "azure.resource-group",
      "basis": {
        "kind": "explicit",
        "text": "one resource group."
      }
    },
    {
      "id": "application-vnet",
      "kind": "group",
      "type": "azure.vnet",
      "basis": {
        "kind": "explicit",
        "text": "Show API and Function VNet integration in an application subnet, and place private endpoints in a data subnet."
      }
    },
    {
      "id": "application-subnet",
      "kind": "group",
      "type": "azure.subnet",
      "basis": {
        "kind": "explicit",
        "text": "API and Function VNet integration in an application subnet."
      }
    },
    {
      "id": "data-subnet",
      "kind": "group",
      "type": "azure.subnet",
      "basis": {
        "kind": "explicit",
        "text": "Private endpoints in a data subnet."
      }
    },
    {
      "id": "public-client",
      "kind": "resource",
      "type": "cloud-agnostic.client",
      "basis": {
        "kind": "explicit",
        "text": "A public client enters through Front Door."
      }
    },
    {
      "id": "operations-client",
      "kind": "resource",
      "type": "cloud-agnostic.actor",
      "basis": {
        "kind": "explicit",
        "text": "An operations client inspects the DLQ and triggers redrive."
      }
    },
    {
      "id": "front-door",
      "kind": "resource",
      "type": "azure.front-door-and-cdn-profiles",
      "basis": {
        "kind": "explicit",
        "text": "A public client enters through Front Door and API Management to an App Service API."
      }
    },
    {
      "id": "api-management",
      "kind": "resource",
      "type": "azure.api-management-services",
      "basis": {
        "kind": "explicit",
        "text": "Front Door and API Management route to an App Service API."
      }
    },
    {
      "id": "app-api",
      "kind": "resource",
      "type": "azure.app-services",
      "basis": {
        "kind": "explicit",
        "text": "App Service API reads and writes SQL through the SQL private endpoint and enqueues work."
      }
    },
    {
      "id": "function-worker",
      "kind": "resource",
      "type": "azure.function-apps",
      "basis": {
        "kind": "explicit",
        "text": "A Function worker consumes Service Bus work, writes files through Storage private endpoint, and writes SQL status."
      }
    },
    {
      "id": "sql-private-endpoint",
      "kind": "resource",
      "type": "azure.private-endpoints",
      "basis": {
        "kind": "explicit",
        "text": "API and Function use the shared SQL private endpoint."
      }
    },
    {
      "id": "storage-private-endpoint",
      "kind": "resource",
      "type": "azure.private-endpoints",
      "basis": {
        "kind": "explicit",
        "text": "Function writes files through a Storage private endpoint."
      }
    },
    {
      "id": "sql-database",
      "kind": "resource",
      "type": "azure.sql-database",
      "basis": {
        "kind": "explicit",
        "text": "Azure SQL is a managed service outside the VNet."
      }
    },
    {
      "id": "storage-account",
      "kind": "resource",
      "type": "azure.storage-accounts",
      "basis": {
        "kind": "explicit",
        "text": "Storage is a managed service outside the VNet."
      }
    },
    {
      "id": "work-queue",
      "kind": "resource",
      "type": "azure.azure-service-bus",
      "basis": {
        "kind": "explicit",
        "text": "Service Bus work queue; messages that reach retry limit dead-letter."
      }
    },
    {
      "id": "dead-letter-queue",
      "kind": "resource",
      "type": "azure.azure-service-bus",
      "basis": {
        "kind": "explicit",
        "text": "Service Bus dead-letter queue for work that reaches retry limit."
      }
    },
    {
      "id": "key-vault",
      "kind": "resource",
      "type": "azure.key-vaults",
      "basis": {
        "kind": "explicit",
        "text": "The API and Function read Key Vault."
      }
    },
    {
      "id": "monitor",
      "kind": "resource",
      "type": "azure.monitor",
      "basis": {
        "kind": "explicit",
        "text": "The API and Function emit telemetry to Azure Monitor."
      }
    }
  ],
  "relationships": [
    {
      "id": "client-to-front-door",
      "source": "public-client",
      "target": "front-door",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "A public client enters through Front Door."
      }
    },
    {
      "id": "front-door-to-apim",
      "source": "front-door",
      "target": "api-management",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "Front Door routes to API Management."
      }
    },
    {
      "id": "apim-to-api",
      "source": "api-management",
      "target": "app-api",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "API Management routes to the App Service API."
      }
    },
    {
      "id": "api-to-sql-endpoint",
      "source": "app-api",
      "target": "sql-private-endpoint",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "The API reads and writes Azure SQL through the shared private endpoint."
      }
    },
    {
      "id": "api-to-work-queue",
      "source": "app-api",
      "target": "work-queue",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "The API enqueues work in Service Bus."
      }
    },
    {
      "id": "work-queue-to-function",
      "source": "work-queue",
      "target": "function-worker",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "The Function worker consumes Service Bus work."
      }
    },
    {
      "id": "function-to-sql-endpoint",
      "source": "function-worker",
      "target": "sql-private-endpoint",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "The Function writes order status through the shared SQL private endpoint."
      }
    },
    {
      "id": "function-to-storage-endpoint",
      "source": "function-worker",
      "target": "storage-private-endpoint",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "The Function writes files through the Storage private endpoint."
      }
    },
    {
      "id": "sql-endpoint-to-sql",
      "source": "sql-private-endpoint",
      "target": "sql-database",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "The private endpoint relation points to Azure SQL."
      }
    },
    {
      "id": "storage-endpoint-to-storage",
      "source": "storage-private-endpoint",
      "target": "storage-account",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "The private endpoint relation points to Storage."
      }
    },
    {
      "id": "work-to-dead-letter",
      "source": "work-queue",
      "target": "dead-letter-queue",
      "kind": "fail",
      "basis": {
        "kind": "explicit",
        "text": "Service Bus work that reaches its retry limit moves to the DLQ."
      }
    },
    {
      "id": "operations-inspects-dlq",
      "source": "operations-client",
      "target": "dead-letter-queue",
      "kind": "peer",
      "basis": {
        "kind": "explicit",
        "text": "The operations client inspects the dead-letter queue."
      }
    },
    {
      "id": "operations-triggers-redrive",
      "source": "operations-client",
      "target": "work-queue",
      "kind": "peer",
      "basis": {
        "kind": "explicit",
        "text": "The operations client triggers redrive to the work queue."
      }
    },
    {
      "id": "dlq-redrive-to-work",
      "source": "dead-letter-queue",
      "target": "work-queue",
      "kind": "peer",
      "basis": {
        "kind": "explicit",
        "text": "The operations client redrives dead-letter messages back to the work queue."
      }
    },
    {
      "id": "api-reads-key-vault",
      "source": "app-api",
      "target": "key-vault",
      "kind": "peer",
      "basis": {
        "kind": "explicit",
        "text": "The API reads Key Vault."
      }
    },
    {
      "id": "function-reads-key-vault",
      "source": "function-worker",
      "target": "key-vault",
      "kind": "peer",
      "basis": {
        "kind": "explicit",
        "text": "The Function reads Key Vault."
      }
    },
    {
      "id": "api-emits-telemetry",
      "source": "app-api",
      "target": "monitor",
      "kind": "peer",
      "basis": {
        "kind": "explicit",
        "text": "The API emits telemetry to Azure Monitor."
      }
    },
    {
      "id": "function-emits-telemetry",
      "source": "function-worker",
      "target": "monitor",
      "kind": "peer",
      "basis": {
        "kind": "explicit",
        "text": "The Function emits telemetry to Azure Monitor."
      }
    }
  ],
