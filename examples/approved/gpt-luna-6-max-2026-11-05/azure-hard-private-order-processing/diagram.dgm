dgm 1
diagram azure_hard_private_order_processing {
  grammar azure
  flow lr
  title "Private Azure Order Processing"

  azure.subscription subscription "Azure subscription" {
    azure.region region "Region" {
      azure.resource-group resource_group "Order processing resource group" {
        azure.front-door-and-cdn-profiles front_door "Front Door" {}
        azure.api-management-services api_management "API Management" {}

        azure.vnet app_vnet "Application VNet" {
          azure.subnet application_subnet "Application subnet" {
            azure.app-services api "Order API" {}
            azure.function-apps worker "Function worker" {}
          }
          azure.subnet data_subnet "Data subnet" {
            azure.private-endpoints sql_private_endpoint "SQL private endpoint" {}
            azure.private-endpoints storage_private_endpoint "Storage private endpoint" {}
          }
        }

        cloud-agnostic.boundary service_bus_scope "Service Bus queues" {
          azure.azure-service-bus work_queue "Work queue" {}
          azure.azure-service-bus dead_letter_queue "Dead-letter queue" {}
        }

        cloud-agnostic.boundary data_services_scope "SQL and Storage" {
          azure.sql-database sql_database "SQL Database" {}
          azure.storage-accounts storage_account "Storage Account" {}
        }

        cloud-agnostic.boundary support_scope "Secrets and telemetry" {
          azure.key-vaults key_vault "Key Vault" {}
          azure.monitor monitor "Azure Monitor" {}
        }
      }
    }
  }

  cloud-agnostic.client public_client "Public client" {}
  cloud-agnostic.client operations_client "Operations client" {}

  public_client -> front_door {
    id client_to_front_door
    label "Order request"
    step 1
    from e
    to w
  }
  front_door -> api_management {
    id front_door_to_apim
    label "Forward request"
    step 2
    from e
    to w
  }
  api_management -> api {
    id apim_to_api
    label "Route request"
    step 3
    from e
    to w
  }
  api -> sql_private_endpoint {
    id api_to_sql_endpoint
    label "SQL read/write"
    step 4
    from s
    to n
  }
  api -> work_queue {
    id api_to_work_queue
    label "Enqueue work"
    step 4
    from e
    to w
  }
  work_queue -> worker {
    id work_queue_to_worker
    label "Dequeue work"
    step 5
    from w
    to e
  }
  worker -> storage_private_endpoint {
    id worker_to_storage_endpoint
    label "Write files"
    step 6
    from s
    to n
  }
  worker -> sql_private_endpoint {
    id worker_to_sql_endpoint
    label "Write order status"
    step 6
    from s
    to n
  }
  sql_private_endpoint -> sql_database {
    id sql_endpoint_to_database
    label "Private endpoint to SQL"
    step 7
    from e
    to w
  }
  storage_private_endpoint -> storage_account {
    id storage_endpoint_to_account
    label "Private endpoint to Storage"
    step 7
    from e
    to w
  }

  work_queue -> dead_letter_queue {
    id work_queue_to_dlq
    label "Retry limit reached"
    style dashed
    kind fail
    from s
    to n
  }
  operations_client -> dead_letter_queue {
    id ops_to_dlq
    label "Inspect DLQ"
    style dashed
    kind flow
    from e
    to w
  }
  operations_client -> work_queue {
    id ops_to_work_queue
    label "Redrive work"
    style dashed
    kind flow
    from e
    to w
  }

  api -> key_vault {
    id api_to_key_vault
    label "Read secrets"
    style dashed
    kind flow
    from w
    to e
  }
  worker -> key_vault {
    id worker_to_key_vault
    label "Read secrets"
    style dashed
    kind flow
    from w
    to e
  }
  api -> monitor {
    id api_to_monitor
    label "Telemetry"
    style dashed
    kind flow
    from w
    to e
  }
  worker -> monitor {
    id worker_to_monitor
    label "Telemetry"
    style dashed
    kind flow
    from w
    to e
  }
}
