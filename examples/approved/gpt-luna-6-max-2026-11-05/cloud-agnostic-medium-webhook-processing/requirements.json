      "group": "primary_region"
    },
    {
      "id": "event_processing_placement",
      "component": "event_processing",
      "relation": "parent",
      "basis": {
        "kind": "explicit",
        "text": "Event Processing is directly inside Private Network."
      },
      "group": "private_network"
    },
    {
      "id": "webhook_edge_placement",
      "component": "webhook_edge",
      "relation": "parent",
      "basis": {
        "kind": "explicit",
        "text": "Webhook Edge is directly inside Primary Region."
      },
      "group": "primary_region"
    },
    {
      "id": "partner_placement",
      "component": "partner",
      "relation": "outside",
      "basis": {
        "kind": "explicit",
        "text": "External Partner is outside Application Cloud."
      },
      "group": "application_cloud"
    },
    {
      "id": "api_gateway_placement",
      "component": "api_gateway",
      "relation": "parent",
      "basis": {
        "kind": "explicit",
        "text": "API Gateway is directly inside Webhook Edge."
      },
      "group": "webhook_edge"
