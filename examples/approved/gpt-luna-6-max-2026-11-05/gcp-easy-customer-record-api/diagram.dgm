dgm 1
diagram gcp-easy-customer-record-api {
  grammar gcp
  flow lr
  title "GCP Customer Record API"
  gcp.organization organization "Google Cloud Organization" {
    gcp.project project "Customer API Project" {
      gcp.region region "Primary Region" {
        gcp.cloud-load-balancing load_balancing "Cloud Load Balancing" {}
        gcp.cloud-run customer_api "Cloud Run API" {}
        gcp.cloud-sql customer_db "Cloud SQL" {}
      }
    }
  }
  cloud-agnostic.client web_client "External Web Client" {}
  web_client -> load_balancing { id https_request label "HTTPS request" step 1 }
  load_balancing -> customer_api { id route_to_api label "forward request" step 2 }
  customer_api -> customer_db { id read_write_records label "read/write records" step 3 }
}
