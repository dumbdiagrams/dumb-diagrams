dgm 1
diagram aws-easy-static-website-delivery {
  grammar aws
  flow lr
  title "AWS static website delivery"

  cloud-agnostic.client visitor "Website visitor"
  aws.cloud aws "AWS Cloud" {
    aws.route-53 dns "DNS"
    aws.cloudfront cdn "CDN"
    aws.simple-storage-service bucket "Website bucket"
  }

  visitor -> dns { id lookup step 1 label "Resolve domain" kind flow }
  dns -> cdn { id alias step 2 label "Alias to CDN" kind flow }
  cdn -> bucket { id origin step 3 label "Fetch files" kind flow }
}
