diagram azure-private-app-service {
  grammar azure
  flow lr
  title "Write-through caching with Azure Managed Redis and Azure SQL Database"

  cloud-agnostic.client client "Client application"

  azure.subscription subscription "Azure subscription" {
    azure.region region "Azure region" {
      cloud-agnostic.boundary architecture "Write-through caching architecture" {
        style dashed
        color blue
        fill none

        azure.vnet vnet "Azure virtual network" {
          cloud-agnostic.boundary application_tier "Application tier" {
            azure.app-services app_service { service "App Service" }
            azure.function-apps functions { service "Write-through function / Repair function" }
          }

          azure.private-endpoints redis_pe { service "Private endpoint (Azure Managed Redis)" }
          azure.private-endpoints sql_pe { service "Private endpoint (Azure SQL Database)" label-position top }
        }

        azure.azure-managed-redis redis { service "Azure Managed Redis distributed cache" }
        azure.sql-database sql { service "Azure SQL Database system of record" label-position bottom }
        azure.monitor monitor { service "Azure Monitor" }
      }
    }
  }

  client -> app_service { id https_requests step 1 label "HTTPS requests" kind flow }
  app_service -> redis_pe { id read_requests step 2 label "Read requests" kind flow }
  redis_pe -> redis { id redis_private_link label "private link" kind flow }
  app_service -> sql_pe { id cache_miss_reads step 4 label "Cache-miss read requests" kind flow }
  sql_pe -> sql { id sql_private_link step 5 label "private link" kind flow }

  app_service -> functions { id write_requests step 2 label "Write requests" kind flow }
  functions -> sql_pe { id authoritative_writes step 3 label "Authoritative writes via Functions" kind flow }
  functions -> redis_pe { id synchronous_cache_update step 4 label "Synchronous write-through cache update" kind flow }

  app_service -> monitor { id app_telemetry label "Metrics and logs" style dashed kind peer }
  redis -> monitor { id redis_telemetry style dashed kind peer }
  sql -> monitor { id sql_telemetry style dashed kind peer }
}
