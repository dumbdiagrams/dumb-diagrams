dgm 1
diagram async-docs {
  grammar aws
  flow lr

  cloud-agnostic.actor client

  aws.region use1 "AWS Region (us-east-1)" {
    aws.vpc main "VPC" {
      aws.az azA "Availability Zone A" {
        aws.subnet.public pubA "Public Subnet A" {
          aws.elastic-load-balancing api_alb "Document API ALB"
        }

        aws.subnet.private appA "Private App Subnet A" {
          aws.elastic-container-service apiA "Document API"
          aws.elastic-container-service workerA "Document worker"
        }
      }

      aws.az azB "Availability Zone B" {
        aws.subnet.public pubB "Public Subnet B" {
          aws.elastic-load-balancing api_alb_b "Document API ALB"
        }

        aws.subnet.private appB "Private App Subnet B" {
          aws.elastic-container-service apiB "Document API"
          aws.elastic-container-service workerB "Document worker"
        }
      }
    }

    cloud-agnostic.boundary queues "Async Queue Tier" {
      aws.simple-queue-service jobs "Processing queue"
      aws.simple-queue-service jobs_dlq "DLQ" { role secondary }
    }

    cloud-agnostic.boundary storage "Storage Tier" {
      aws.simple-storage-service artifacts "Processed artifacts"
    }
  }

  client -> api_alb { id e1 step 1 kind flow }
  api_alb -> apiA { id e2 kind flow }
  apiA -> jobs { id e3 kind flow }
  jobs -> workerA { id e4 kind flow }
  workerA -> artifacts { id e5 kind flow }
  jobs -> jobs_dlq { id e6 style dashed kind fail }
}
