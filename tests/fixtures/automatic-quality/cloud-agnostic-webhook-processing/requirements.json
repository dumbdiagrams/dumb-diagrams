        "kind": "explicit",
        "text": "Prompt: a production account"
      }
    },
    {
      "id": "region-count",
      "kind": "group",
      "type": "cloud-agnostic.region",
      "min": 1,
      "max": 1,
      "basis": {
        "kind": "explicit",
        "text": "Prompt: a primary region"
      }
    },
    {
      "id": "network-count",
      "kind": "group",
      "type": "cloud-agnostic.network",
      "min": 1,
      "max": 1,
      "basis": {
        "kind": "explicit",
        "text": "Prompt: a private network"
      }
    },
    {
      "id": "partner-count",
      "kind": "resource",
      "type": "cloud-agnostic.actor",
      "min": 1,
      "max": 1,
      "basis": {
        "kind": "explicit",
        "text": "Prompt: an external partner"
      }
    },
    {
      "id": "gateway-count",
      "kind": "resource",
      "type": "cloud-agnostic.gateway",
      "min": 1,
      "max": 1,
      "basis": {
        "kind": "explicit",
        "text": "Prompt: an API gateway"
      }
    },
    {
      "id": "queue-count",
      "kind": "resource",
      "type": "cloud-agnostic.queue",
      "min": 1,
      "max": 1,
      "basis": {
        "kind": "explicit",
        "text": "Prompt: a queue"
      }
    },
    {
      "id": "database-count",
      "kind": "resource",
      "type": "cloud-agnostic.database",
      "min": 1,
      "max": 1,
      "basis": {
        "kind": "explicit",
        "text": "Prompt: an event database"
      }
    },
    {
      "id": "archive-count",
      "kind": "resource",
      "type": "cloud-agnostic.object-storage",
      "min": 1,
      "max": 1,
      "basis": {
        "kind": "explicit",
        "text": "Prompt: object storage"
      }
    },
    {
      "id": "boundaries-in-region",
      "kind": "group",
      "type": "cloud-agnostic.boundary",
      "min": 2,
      "max": 2,
      "within": "primary-region",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: webhook-edge boundary and event-processing boundary"
      }
    },
    {
      "id": "ingress-function-count",
      "kind": "resource",
      "type": "cloud-agnostic.function",
      "min": 1,
      "max": 1,
      "within": "webhook-edge",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: webhook ingress function"
      }
    },
    {
      "id": "processor-function-count",
      "kind": "resource",
      "type": "cloud-agnostic.function",
      "min": 1,
      "max": 1,
      "within": "event-processing",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: event processor"
      }
    }
