      "group": "application-cloud"
    },
    {
      "id": "region-in-account",
      "component": "primary-region",
      "relation": "inside",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: Nest ... primary region ... inside an application cloud"
      },
      "group": "production-account"
    },
    {
      "id": "network-in-region",
      "component": "private-network",
      "relation": "inside",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: private network inside an application cloud [primary region]"
