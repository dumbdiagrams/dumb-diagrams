  "placement": [
    {
      "id": "cloud-root",
      "component": "application-cloud",
      "relation": "root",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: application cloud"
      }
    },
    {
      "id": "account-in-cloud",
