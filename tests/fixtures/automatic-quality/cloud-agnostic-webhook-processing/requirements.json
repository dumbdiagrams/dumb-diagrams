      "kind": "group",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: production account"
      }
    },
    {
      "id": "primary-region",
      "kind": "group",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: primary region"
      }
    },
