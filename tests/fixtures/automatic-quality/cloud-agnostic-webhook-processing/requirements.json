      "group": "primary-region"
    },
    {
      "id": "processing-in-network",
      "component": "event-processing",
      "relation": "inside",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: event-processing boundary within the network"
      },
      "group": "private-network"
    },
    {
      "id": "gateway-in-edge",
      "component": "api-gateway",
      "relation": "inside",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: Place the gateway ... in a webhook-edge boundary"
      },
      "group": "webhook-edge"
    },
    {
      "id": "ingress-in-edge",
      "component": "ingress-function",
      "relation": "inside",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: Place ... ingress function together in a webhook-edge boundary"
      },
      "group": "webhook-edge"
    },
    {
      "id": "queue-in-processing",
      "component": "event-queue",
      "relation": "inside",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: Place the queue ... in an event-processing boundary within the network"
      },
      "group": "event-processing"
    },
    {
      "id": "processor-in-processing",
      "component": "event-processor",
      "relation": "inside",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: Place ... processor ... in an event-processing boundary within the network"
      },
      "group": "event-processing"
    },
    {
      "id": "db-in-processing",
      "component": "event-database",
      "relation": "inside",
      "basis": {
        "kind": "explicit",
