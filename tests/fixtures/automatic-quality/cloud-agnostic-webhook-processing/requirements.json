  "relationships": [
    {
      "id": "partner-gateway",
      "source": "partner",
      "target": "api-gateway",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: external partner sends webhook events to an API gateway"
      }
    },
    {
      "id": "gateway-ingress",
      "source": "api-gateway",
      "target": "ingress-function",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: API gateway and webhook ingress function"
      }
    },
    {
      "id": "ingress-queue",
      "source": "ingress-function",
      "target": "event-queue",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: ingress function queues events"
      }
    },
    {
      "id": "ingress-idempotency",
      "source": "ingress-function",
      "target": "event-database",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: writes an idempotency key to the event database"
      }
    },
    {
      "id": "queue-processor",
      "source": "event-queue",
      "target": "event-processor",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: event processor consumes the queue"
      }
    },
    {
      "id": "processor-status",
      "source": "event-processor",
      "target": "event-database",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: stores processed status in the same database"
      }
    },
    {
      "id": "processor-archive",
      "source": "event-processor",
      "target": "payload-archive",
      "kind": "flow",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: archives the payload in object storage"
      }
    }
