      "group": "primary-region"
    },
    {
      "id": "edge-in-region",
      "component": "webhook-edge",
      "relation": "inside",
      "basis": {
        "kind": "explicit",
        "text": "Prompt: webhook-edge boundary; not stated inside the private network"
