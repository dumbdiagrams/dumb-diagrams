dgm 1
diagram cloud_agnostic_webhook_processing {
  grammar cloud-agnostic
  flow lr
  title "Webhook processing"

  cloud-agnostic.actor partner "External partner"

  cloud-agnostic.cloud application_cloud "Application cloud" {
    cloud-agnostic.account production "Production account" {
      cloud-agnostic.region primary_region "Primary region" {
        cloud-agnostic.boundary webhook_edge "Webhook edge" {
          cloud-agnostic.gateway api_gateway "API gateway"
          cloud-agnostic.function ingress_function "Webhook ingress function"
        }
        cloud-agnostic.object-storage payload_archive "Payload archive"
        cloud-agnostic.network private_network "Private network" {
          cloud-agnostic.boundary event_processing "Event processing" {
            cloud-agnostic.queue event_queue "Event queue"
            cloud-agnostic.container event_processor "Event processor"
            cloud-agnostic.database event_database "Event database"
          }
        }
      }
    }
  }

  partner -> api_gateway { id send_webhook_events label "send webhook events" step 1 }
  api_gateway -> ingress_function { id invoke_ingress label "invoke" step 2 }
  ingress_function -> event_database { id write_idempotency_key label "write idempotency key" step 3 }
  ingress_function -> event_queue { id queue_event label "queue event" step 4 }
  event_queue -> event_processor { id deliver_event label "deliver events" step 5 }
  event_processor -> event_database { id store_processed_status label "store processed status" step 6 }
  event_processor -> payload_archive { id archive_payload label "archive payload" step 6 }
}
