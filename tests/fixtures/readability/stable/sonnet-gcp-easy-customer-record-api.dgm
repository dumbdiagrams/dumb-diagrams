dgm 1
diagram gcp-customer-record-api {
  grammar gcp
  flow lr
  title "Customer Record API"

  cloud-agnostic.client client "Web Client"

  gcp.organization org "Organization" {
    gcp.project project "Project" {
      gcp.region region "Primary Region" {
        gcp.cloud-load-balancing lb "Load Balancing"
        gcp.cloud-run api "Customer API"
        gcp.cloud-sql db "Customer Records"
      }
    }
  }

  client -> lb { id client_to_lb label "HTTPS" }
  lb -> api { id lb_to_api }
  api -> db { id api_to_db label "Read/write" }
}
