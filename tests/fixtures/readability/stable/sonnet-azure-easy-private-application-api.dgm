dgm 1
diagram azure-private-application-api {
  grammar azure
  flow lr
  title "Azure Private Application API"

  azure.subscription cloud "Azure subscription" {
    cloud-agnostic.client client "Client"
    azure.api-management-services apim "API Management"

    azure.vnet vnet "Application network" {
      azure.function-apps function "Function"
      azure.private-endpoints private-endpoint "Private endpoint"
    }

    azure.sql-database sql "SQL database"
  }

  client -> apim { id client-to-apim }
  apim -> function { id apim-to-function }
  function -> private-endpoint { id function-to-pe }
  private-endpoint -> sql { id pe-to-sql }
}
