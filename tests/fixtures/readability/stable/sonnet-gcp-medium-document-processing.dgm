dgm 1
diagram gcp-document-processing {
  grammar gcp
  flow lr
  title "Document Processing"

  cloud-agnostic.actor partner "Partner"

  gcp.organization org "Organization" {
    gcp.project project "Project" {
      gcp.region region "Primary Region" {
        gcp.cloud-run intake "Intake"
        gcp.cloud-storage source-bucket "Source Bucket"
        gcp.pub-sub events "Events"
        gcp.cloud-run processor "Processor"
        gcp.cloud-storage normalized-bucket "Normalized Bucket"
        gcp.cloud-sql status-db "Status"
      }
    }
  }

  partner -> intake { id upload label "Upload" }
  intake -> source-bucket { id store-original label "Store" }
  source-bucket -> events { id notify label "Notify" }
  events -> processor { id consume label "Consume" }
  processor -> source-bucket { id read-original label "Read" }
  processor -> normalized-bucket { id store-normalized label "Normalized" }
  processor -> status-db { id write-status label "Status" }
}
