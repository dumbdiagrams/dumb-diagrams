dgm 1
diagram cloud_agnostic_customer_record_api {
  grammar cloud-agnostic
  flow lr
  title "Customer-record API"

  cloud-agnostic.client web_client "Web client"

  cloud-agnostic.cloud application_cloud "Application cloud" {
    cloud-agnostic.account production "Production account" {
      cloud-agnostic.region primary_region "Primary region" {
        cloud-agnostic.gateway api_gateway "API gateway"
        cloud-agnostic.container customer_api "Customer API service"
        cloud-agnostic.database customer_db "Customer database"
      }
    }
  }

  web_client -> api_gateway { id send_https_requests label "HTTPS requests" step 1 }
  api_gateway -> customer_api { id forward_requests label "forward requests" step 2 }
  customer_api -> customer_db { id read_write_records kind bidirectional label "read and write records" step 3 }
}
